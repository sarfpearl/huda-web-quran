{"verses":[{"id":6180,"verse_key":"104:1","text_indopak_nastaleeq":"وَیْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةِ ۟ۙ"},{"id":6181,"verse_key":"104:2","text_indopak_nastaleeq":"لَّذِیْ جَمَعَ مَالًا وَّعَدَّدَهٗ ۟ۙ"},{"id":6182,"verse_key":"104:3","text_indopak_nastaleeq":"یَحْسَبُ اَنَّ مَالَهٗۤ اَخْلَدَهٗ ۟ۚ"},{"id":6183,"verse_key":"104:4","text_indopak_nastaleeq":"كَلَّا لَیُنْۢبَذَنَّ فِی الْحُطَمَةِ ۟ؗۖ"},{"id":6184,"verse_key":"104:5","text_indopak_nastaleeq":"وَمَاۤ اَدْرٰىكَ مَا الْحُطَمَةُ ۟ؕ"},{"id":6185,"verse_key":"104:6","text_indopak_nastaleeq":"نَارُ اللّٰهِ الْمُوْقَدَةُ ۟ۙ"},{"id":6186,"verse_key":"104:7","text_indopak_nastaleeq":"الَّتِیْ تَطَّلِعُ عَلَی الْاَفْـِٕدَةِ ۟ؕ"},{"id":6187,"verse_key":"104:8","text_indopak_nastaleeq":"اِنَّهَا عَلَیْهِمْ مُّؤْصَدَةٌ ۟ۙ"},{"id":6188,"verse_key":"104:9","text_indopak_nastaleeq":"فِیْ عَمَدٍ مُّمَدَّدَةٍ ۟۠"}],"meta":{"filters":{"chapter_number":"104"}}}