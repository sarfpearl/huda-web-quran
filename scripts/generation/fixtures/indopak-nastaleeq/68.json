{"verses":[{"id":5272,"verse_key":"68:1","text_indopak_nastaleeq":"نٓ وَالْقَلَمِ وَمَا یَسْطُرُوْنَ ۟ۙ"},{"id":5273,"verse_key":"68:2","text_indopak_nastaleeq":"مَاۤ اَنْتَ بِنِعْمَةِ رَبِّكَ بِمَجْنُوْنٍ ۟ۚ"},{"id":5274,"verse_key":"68:3","text_indopak_nastaleeq":"وَاِنَّ لَكَ لَاَجْرًا غَیْرَ مَمْنُوْنٍ ۟ۚ"},{"id":5275,"verse_key":"68:4","text_indopak_nastaleeq":"وَاِنَّكَ لَعَلٰی خُلُقٍ عَظِیْمٍ ۟"},{"id":5276,"verse_key":"68:5","text_indopak_nastaleeq":"فَسَتُبْصِرُ وَیُبْصِرُوْنَ ۟ۙ"},{"id":5277,"verse_key":"68:6","text_indopak_nastaleeq":"بِاَیِّىكُمُ الْمَفْتُوْنُ ۟"},{"id":5278,"verse_key":"68:7","text_indopak_nastaleeq":"اِنَّ رَبَّكَ هُوَ اَعْلَمُ بِمَنْ ضَلَّ عَنْ سَبِیْلِهٖ ۪ وَهُوَ اَعْلَمُ بِالْمُهْتَدِیْنَ ۟"},{"id":5279,"verse_key":"68:8","text_indopak_nastaleeq":"فَلَا تُطِعِ الْمُكَذِّبِیْنَ ۟"},{"id":5280,"verse_key":"68:9","text_indopak_nastaleeq":"وَدُّوْا لَوْ تُدْهِنُ فَیُدْهِنُوْنَ ۟"},{"id":5281,"verse_key":"68:10","text_indopak_nastaleeq":"وَلَا تُطِعْ كُلَّ حَلَّافٍ مَّهِیْنٍ ۟ۙ"},{"id":5282,"verse_key":"68:11","text_indopak_nastaleeq":"هَمَّازٍ مَّشَّآءٍ بِنَمِیْمٍ ۟ۙ"},{"id":5283,"verse_key":"68:12","text_indopak_nastaleeq":"مَّنَّاعٍ لِّلْخَیْرِ مُعْتَدٍ اَثِیْمٍ ۟ۙ"},{"id":5284,"verse_key":"68:13","text_indopak_nastaleeq":"عُتُلٍّ بَعْدَ ذٰلِكَ زَنِیْمٍ ۟ۙ"},{"id":5285,"verse_key":"68:14","text_indopak_nastaleeq":"اَنْ كَانَ ذَا مَالٍ وَّبَنِیْنَ ۟ؕ"},{"id":5286,"verse_key":"68:15","text_indopak_nastaleeq":"اِذَا تُتْلٰی عَلَیْهِ اٰیٰتُنَا قَالَ اَسَاطِیْرُ الْاَوَّلِیْنَ ۟"},{"id":5287,"verse_key":"68:16","text_indopak_nastaleeq":"سَنَسِمُهٗ عَلَی الْخُرْطُوْمِ ۟"},{"id":5288,"verse_key":"68:17","text_indopak_nastaleeq":"اِنَّا بَلَوْنٰهُمْ كَمَا بَلَوْنَاۤ اَصْحٰبَ الْجَنَّةِ ۚ اِذْ اَقْسَمُوْا لَیَصْرِمُنَّهَا مُصْبِحِیْنَ ۟ۙ"},{"id":5289,"verse_key":"68:18","text_indopak_nastaleeq":"وَلَا یَسْتَثْنُوْنَ ۟"},{"id":5290,"verse_key":"68:19","text_indopak_nastaleeq":"فَطَافَ عَلَیْهَا طَآىِٕفٌ مِّنْ رَّبِّكَ وَهُمْ نَآىِٕمُوْنَ ۟"},{"id":5291,"verse_key":"68:20","text_indopak_nastaleeq":"فَاَصْبَحَتْ كَالصَّرِیْمِ ۟ۙ"},{"id":5292,"verse_key":"68:21","text_indopak_nastaleeq":"فَتَنَادَوْا مُصْبِحِیْنَ ۟ۙ"},{"id":5293,"verse_key":"68:22","text_indopak_nastaleeq":"اَنِ اغْدُوْا عَلٰی حَرْثِكُمْ اِنْ كُنْتُمْ صٰرِمِیْنَ ۟"},{"id":5294,"verse_key":"68:23","text_indopak_nastaleeq":"فَانْطَلَقُوْا وَهُمْ یَتَخَافَتُوْنَ ۟ۙ"},{"id":5295,"verse_key":"68:24","text_indopak_nastaleeq":"اَنْ لَّا یَدْخُلَنَّهَا الْیَوْمَ عَلَیْكُمْ مِّسْكِیْنٌ ۟ۙ"},{"id":5296,"verse_key":"68:25","text_indopak_nastaleeq":"وَّغَدَوْا عَلٰی حَرْدٍ قٰدِرِیْنَ ۟"},{"id":5297,"verse_key":"68:26","text_indopak_nastaleeq":"فَلَمَّا رَاَوْهَا قَالُوْۤا اِنَّا لَضَآلُّوْنَ ۟ۙ"},{"id":5298,"verse_key":"68:27","text_indopak_nastaleeq":"بَلْ نَحْنُ مَحْرُوْمُوْنَ ۟"},{"id":5299,"verse_key":"68:28","text_indopak_nastaleeq":"قَالَ اَوْسَطُهُمْ اَلَمْ اَقُلْ لَّكُمْ لَوْلَا تُسَبِّحُوْنَ ۟"},{"id":5300,"verse_key":"68:29","text_indopak_nastaleeq":"قَالُوْا سُبْحٰنَ رَبِّنَاۤ اِنَّا كُنَّا ظٰلِمِیْنَ ۟"},{"id":5301,"verse_key":"68:30","text_indopak_nastaleeq":"فَاَقْبَلَ بَعْضُهُمْ عَلٰی بَعْضٍ یَّتَلَاوَمُوْنَ ۟"},{"id":5302,"verse_key":"68:31","text_indopak_nastaleeq":"قَالُوْا یٰوَیْلَنَاۤ اِنَّا كُنَّا طٰغِیْنَ ۟"},{"id":5303,"verse_key":"68:32","text_indopak_nastaleeq":"عَسٰی رَبُّنَاۤ اَنْ یُّبْدِلَنَا خَیْرًا مِّنْهَاۤ اِنَّاۤ اِلٰی رَبِّنَا رٰغِبُوْنَ ۟"},{"id":5304,"verse_key":"68:33","text_indopak_nastaleeq":"كَذٰلِكَ الْعَذَابُ ؕ وَلَعَذَابُ الْاٰخِرَةِ اَكْبَرُ ۘ لَوْ كَانُوْا یَعْلَمُوْنَ ۟۠"},{"id":5305,"verse_key":"68:34","text_indopak_nastaleeq":"اِنَّ لِلْمُتَّقِیْنَ عِنْدَ رَبِّهِمْ جَنّٰتِ النَّعِیْمِ ۟"},{"id":5306,"verse_key":"68:35","text_indopak_nastaleeq":"اَفَنَجْعَلُ الْمُسْلِمِیْنَ كَالْمُجْرِمِیْنَ ۟ؕ"},{"id":5307,"verse_key":"68:36","text_indopak_nastaleeq":"مَا لَكُمْ ۥ كَیْفَ تَحْكُمُوْنَ ۟ۚ"},{"id":5308,"verse_key":"68:37","text_indopak_nastaleeq":"اَمْ لَكُمْ كِتٰبٌ فِیْهِ تَدْرُسُوْنَ ۟ۙ"},{"id":5309,"verse_key":"68:38","text_indopak_nastaleeq":"اِنَّ لَكُمْ فِیْهِ لَمَا تَخَیَّرُوْنَ ۟ۚ"},{"id":5310,"verse_key":"68:39","text_indopak_nastaleeq":"اَمْ لَكُمْ اَیْمَانٌ عَلَیْنَا بَالِغَةٌ اِلٰی یَوْمِ الْقِیٰمَةِ ۙ اِنَّ لَكُمْ لَمَا تَحْكُمُوْنَ ۟ۚ"},{"id":5311,"verse_key":"68:40","text_indopak_nastaleeq":"سَلْهُمْ اَیُّهُمْ بِذٰلِكَ زَعِیْمٌ ۟ۚۛ"},{"id":5312,"verse_key":"68:41","text_indopak_nastaleeq":"اَمْ لَهُمْ شُرَكَآءُ ۛۚ فَلْیَاْتُوْا بِشُرَكَآىِٕهِمْ اِنْ كَانُوْا صٰدِقِیْنَ ۟"},{"id":5313,"verse_key":"68:42","text_indopak_nastaleeq":"یَوْمَ یُكْشَفُ عَنْ سَاقٍ وَّیُدْعَوْنَ اِلَی السُّجُوْدِ فَلَا یَسْتَطِیْعُوْنَ ۟ۙ"},{"id":5314,"verse_key":"68:43","text_indopak_nastaleeq":"خَاشِعَةً اَبْصَارُهُمْ تَرْهَقُهُمْ ذِلَّةٌ ؕ وَقَدْ كَانُوْا یُدْعَوْنَ اِلَی السُّجُوْدِ وَهُمْ سٰلِمُوْنَ ۟"},{"id":5315,"verse_key":"68:44","text_indopak_nastaleeq":"فَذَرْنِیْ وَمَنْ یُّكَذِّبُ بِهٰذَا الْحَدِیْثِ ؕ سَنَسْتَدْرِجُهُمْ مِّنْ حَیْثُ لَا یَعْلَمُوْنَ ۟ۙ"},{"id":5316,"verse_key":"68:45","text_indopak_nastaleeq":"وَاُمْلِیْ لَهُمْ ؕ اِنَّ كَیْدِیْ مَتِیْنٌ ۟"},{"id":5317,"verse_key":"68:46","text_indopak_nastaleeq":"اَمْ تَسْـَٔلُهُمْ اَجْرًا فَهُمْ مِّنْ مَّغْرَمٍ مُّثْقَلُوْنَ ۟ۚ"},{"id":5318,"verse_key":"68:47","text_indopak_nastaleeq":"اَمْ عِنْدَهُمُ الْغَیْبُ فَهُمْ یَكْتُبُوْنَ ۟"},{"id":5319,"verse_key":"68:48","text_indopak_nastaleeq":"فَاصْبِرْ لِحُكْمِ رَبِّكَ وَلَا تَكُنْ كَصَاحِبِ الْحُوْتِ ۘ اِذْ نَادٰی وَهُوَ مَكْظُوْمٌ ۟ؕ"},{"id":5320,"verse_key":"68:49","text_indopak_nastaleeq":"لَوْلَاۤ اَنْ تَدٰرَكَهٗ نِعْمَةٌ مِّنْ رَّبِّهٖ لَنُبِذَ بِالْعَرَآءِ وَهُوَ مَذْمُوْمٌ ۟"},{"id":5321,"verse_key":"68:50","text_indopak_nastaleeq":"فَاجْتَبٰىهُ رَبُّهٗ فَجَعَلَهٗ مِنَ الصّٰلِحِیْنَ ۟"},{"id":5322,"verse_key":"68:51","text_indopak_nastaleeq":"وَاِنْ یَّكَادُ الَّذِیْنَ كَفَرُوْا لَیُزْلِقُوْنَكَ بِاَبْصَارِهِمْ لَمَّا سَمِعُوا الذِّكْرَ وَیَقُوْلُوْنَ اِنَّهٗ لَمَجْنُوْنٌ ۟ۘ"},{"id":5323,"verse_key":"68:52","text_indopak_nastaleeq":"وَمَا هُوَ اِلَّا ذِكْرٌ لِّلْعٰلَمِیْنَ ۟۠"}],"meta":{"filters":{"chapter_number":"68"}}}