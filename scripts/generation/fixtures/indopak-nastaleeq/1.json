{"verses":[{"id":1,"verse_key":"1:1","text_indopak_nastaleeq":"بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِیْمِ ۟"},{"id":2,"verse_key":"1:2","text_indopak_nastaleeq":"اَلْحَمْدُ لِلّٰهِ رَبِّ الْعٰلَمِیْنَ ۟ۙ"},{"id":3,"verse_key":"1:3","text_indopak_nastaleeq":"الرَّحْمٰنِ الرَّحِیْمِ ۟ۙ"},{"id":4,"verse_key":"1:4","text_indopak_nastaleeq":"مٰلِكِ یَوْمِ الدِّیْنِ ۟ؕ"},{"id":5,"verse_key":"1:5","text_indopak_nastaleeq":"اِیَّاكَ نَعْبُدُ وَاِیَّاكَ نَسْتَعِیْنُ ۟ؕ"},{"id":6,"verse_key":"1:6","text_indopak_nastaleeq":"اِهْدِنَا الصِّرَاطَ الْمُسْتَقِیْمَ ۟ۙ"},{"id":7,"verse_key":"1:7","text_indopak_nastaleeq":"صِرَاطَ الَّذِیْنَ اَنْعَمْتَ عَلَیْهِمْ ۙ۬ۦ غَیْرِ الْمَغْضُوْبِ عَلَیْهِمْ وَلَا الضَّآلِّیْنَ ۟۠"}],"meta":{"filters":{"chapter_number":"1"}}}