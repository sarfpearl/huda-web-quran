{"verses":[{"id":3789,"verse_key":"37:1","text_indopak_nastaleeq":"وَالصّٰٓفّٰتِ صَفًّا ۟ۙ"},{"id":3790,"verse_key":"37:2","text_indopak_nastaleeq":"فَالزّٰجِرٰتِ زَجْرًا ۟ۙ"},{"id":3791,"verse_key":"37:3","text_indopak_nastaleeq":"فَالتّٰلِیٰتِ ذِكْرًا ۟ۙ"},{"id":3792,"verse_key":"37:4","text_indopak_nastaleeq":"اِنَّ اِلٰهَكُمْ لَوَاحِدٌ ۟ؕ"},{"id":3793,"verse_key":"37:5","text_indopak_nastaleeq":"رَبُّ السَّمٰوٰتِ وَالْاَرْضِ وَمَا بَیْنَهُمَا وَرَبُّ الْمَشَارِقِ ۟ؕ"},{"id":3794,"verse_key":"37:6","text_indopak_nastaleeq":"اِنَّا زَیَّنَّا السَّمَآءَ الدُّنْیَا بِزِیْنَةِ لْكَوَاكِبِ ۟ۙ"},{"id":3795,"verse_key":"37:7","text_indopak_nastaleeq":"وَحِفْظًا مِّنْ كُلِّ شَیْطٰنٍ مَّارِدٍ ۟ۚ"},{"id":3796,"verse_key":"37:8","text_indopak_nastaleeq":"لَا یَسَّمَّعُوْنَ اِلَی الْمَلَاِ الْاَعْلٰی وَیُقْذَفُوْنَ مِنْ كُلِّ جَانِبٍ ۟ۗۖ"},{"id":3797,"verse_key":"37:9","text_indopak_nastaleeq":"دُحُوْرًا وَّلَهُمْ عَذَابٌ وَّاصِبٌ ۟ۙ"},{"id":3798,"verse_key":"37:10","text_indopak_nastaleeq":"اِلَّا مَنْ خَطِفَ الْخَطْفَةَ فَاَتْبَعَهٗ شِهَابٌ ثَاقِبٌ ۟"},{"id":3799,"verse_key":"37:11","text_indopak_nastaleeq":"فَاسْتَفْتِهِمْ اَهُمْ اَشَدُّ خَلْقًا اَمْ مَّنْ خَلَقْنَا ؕ اِنَّا خَلَقْنٰهُمْ مِّنْ طِیْنٍ لَّازِبٍ ۟"},{"id":3800,"verse_key":"37:12","text_indopak_nastaleeq":"بَلْ عَجِبْتَ وَیَسْخَرُوْنَ ۪۟"},{"id":3801,"verse_key":"37:13","text_indopak_nastaleeq":"وَاِذَا ذُكِّرُوْا لَا یَذْكُرُوْنَ ۪۟"},{"id":3802,"verse_key":"37:14","text_indopak_nastaleeq":"وَاِذَا رَاَوْا اٰیَةً یَّسْتَسْخِرُوْنَ ۪۟"},{"id":3803,"verse_key":"37:15","text_indopak_nastaleeq":"وَقَالُوْۤا اِنْ هٰذَاۤ اِلَّا سِحْرٌ مُّبِیْنٌ ۟ۚۖ"},{"id":3804,"verse_key":"37:16","text_indopak_nastaleeq":"ءَاِذَا مِتْنَا وَكُنَّا تُرَابًا وَّعِظَامًا ءَاِنَّا لَمَبْعُوْثُوْنَ ۟ۙ"},{"id":3805,"verse_key":"37:17","text_indopak_nastaleeq":"اَوَاٰبَآؤُنَا الْاَوَّلُوْنَ ۟ؕ"},{"id":3806,"verse_key":"37:18","text_indopak_nastaleeq":"قُلْ نَعَمْ وَاَنْتُمْ دَاخِرُوْنَ ۟ۚ"},{"id":3807,"verse_key":"37:19","text_indopak_nastaleeq":"فَاِنَّمَا هِیَ زَجْرَةٌ وَّاحِدَةٌ فَاِذَا هُمْ یَنْظُرُوْنَ ۟"},{"id":3808,"verse_key":"37:20","text_indopak_nastaleeq":"وَقَالُوْا یٰوَیْلَنَا هٰذَا یَوْمُ الدِّیْنِ ۟"},{"id":3809,"verse_key":"37:21","text_indopak_nastaleeq":"هٰذَا یَوْمُ الْفَصْلِ الَّذِیْ كُنْتُمْ بِهٖ تُكَذِّبُوْنَ ۟۠"},{"id":3810,"verse_key":"37:22","text_indopak_nastaleeq":"اُحْشُرُوا الَّذِیْنَ ظَلَمُوْا وَاَزْوَاجَهُمْ وَمَا كَانُوْا یَعْبُدُوْنَ ۟ۙ"},{"id":3811,"verse_key":"37:23","text_indopak_nastaleeq":"مِنْ دُوْنِ اللّٰهِ فَاهْدُوْهُمْ اِلٰی صِرَاطِ الْجَحِیْمِ ۟"},{"id":3812,"verse_key":"37:24","text_indopak_nastaleeq":"وَقِفُوْهُمْ اِنَّهُمْ مَّسْـُٔوْلُوْنَ ۟ۙ"},{"id":3813,"verse_key":"37:25","text_indopak_nastaleeq":"مَا لَكُمْ لَا تَنَاصَرُوْنَ ۟"},{"id":3814,"verse_key":"37:26","text_indopak_nastaleeq":"بَلْ هُمُ الْیَوْمَ مُسْتَسْلِمُوْنَ ۟"},{"id":3815,"verse_key":"37:27","text_indopak_nastaleeq":"وَاَقْبَلَ بَعْضُهُمْ عَلٰی بَعْضٍ یَّتَسَآءَلُوْنَ ۟"},{"id":3816,"verse_key":"37:28","text_indopak_nastaleeq":"قَالُوْۤا اِنَّكُمْ كُنْتُمْ تَاْتُوْنَنَا عَنِ الْیَمِیْنِ ۟"},{"id":3817,"verse_key":"37:29","text_indopak_nastaleeq":"قَالُوْا بَلْ لَّمْ تَكُوْنُوْا مُؤْمِنِیْنَ ۟ۚ"},{"id":3818,"verse_key":"37:30","text_indopak_nastaleeq":"وَمَا كَانَ لَنَا عَلَیْكُمْ مِّنْ سُلْطٰنٍ ۚ بَلْ كُنْتُمْ قَوْمًا طٰغِیْنَ ۟"},{"id":3819,"verse_key":"37:31","text_indopak_nastaleeq":"فَحَقَّ عَلَیْنَا قَوْلُ رَبِّنَاۤ ۖۗ اِنَّا لَذَآىِٕقُوْنَ ۟"},{"id":3820,"verse_key":"37:32","text_indopak_nastaleeq":"فَاَغْوَیْنٰكُمْ اِنَّا كُنَّا غٰوِیْنَ ۟"},{"id":3821,"verse_key":"37:33","text_indopak_nastaleeq":"فَاِنَّهُمْ یَوْمَىِٕذٍ فِی الْعَذَابِ مُشْتَرِكُوْنَ ۟"},{"id":3822,"verse_key":"37:34","text_indopak_nastaleeq":"اِنَّا كَذٰلِكَ نَفْعَلُ بِالْمُجْرِمِیْنَ ۟"},{"id":3823,"verse_key":"37:35","text_indopak_nastaleeq":"اِنَّهُمْ كَانُوْۤا اِذَا قِیْلَ لَهُمْ لَاۤ اِلٰهَ اِلَّا اللّٰهُ یَسْتَكْبِرُوْنَ ۟ۙ"},{"id":3824,"verse_key":"37:36","text_indopak_nastaleeq":"وَیَقُوْلُوْنَ اَىِٕنَّا لَتَارِكُوْۤا اٰلِهَتِنَا لِشَاعِرٍ مَّجْنُوْنٍ ۟ؕ"},{"id":3825,"verse_key":"37:37","text_indopak_nastaleeq":"بَلْ جَآءَ بِالْحَقِّ وَصَدَّقَ الْمُرْسَلِیْنَ ۟"},{"id":3826,"verse_key":"37:38","text_indopak_nastaleeq":"اِنَّكُمْ لَذَآىِٕقُوا الْعَذَابِ الْاَلِیْمِ ۟ۚ"},{"id":3827,"verse_key":"37:39","text_indopak_nastaleeq":"وَمَا تُجْزَوْنَ اِلَّا مَا كُنْتُمْ تَعْمَلُوْنَ ۟ۙ"},{"id":3828,"verse_key":"37:40","text_indopak_nastaleeq":"اِلَّا عِبَادَ اللّٰهِ الْمُخْلَصِیْنَ ۟"},{"id":3829,"verse_key":"37:41","text_indopak_nastaleeq":"اُولٰٓىِٕكَ لَهُمْ رِزْقٌ مَّعْلُوْمٌ ۟ۙ"},{"id":3830,"verse_key":"37:42","text_indopak_nastaleeq":"فَوَاكِهُ ۚ وَهُمْ مُّكْرَمُوْنَ ۟ۙ"},{"id":3831,"verse_key":"37:43","text_indopak_nastaleeq":"فِیْ جَنّٰتِ النَّعِیْمِ ۟ۙ"},{"id":3832,"verse_key":"37:44","text_indopak_nastaleeq":"عَلٰی سُرُرٍ مُّتَقٰبِلِیْنَ ۟"},{"id":3833,"verse_key":"37:45","text_indopak_nastaleeq":"یُطَافُ عَلَیْهِمْ بِكَاْسٍ مِّنْ مَّعِیْنٍ ۟ۙ"},{"id":3834,"verse_key":"37:46","text_indopak_nastaleeq":"بَیْضَآءَ لَذَّةٍ لِّلشّٰرِبِیْنَ ۟ۚۖ"},{"id":3835,"verse_key":"37:47","text_indopak_nastaleeq":"لَا فِیْهَا غَوْلٌ وَّلَا هُمْ عَنْهَا یُنْزَفُوْنَ ۟"},{"id":3836,"verse_key":"37:48","text_indopak_nastaleeq":"وَعِنْدَهُمْ قٰصِرٰتُ الطَّرْفِ عِیْنٌ ۟ۙ"},{"id":3837,"verse_key":"37:49","text_indopak_nastaleeq":"كَاَنَّهُنَّ بَیْضٌ مَّكْنُوْنٌ ۟"},{"id":3838,"verse_key":"37:50","text_indopak_nastaleeq":"فَاَقْبَلَ بَعْضُهُمْ عَلٰی بَعْضٍ یَّتَسَآءَلُوْنَ ۟"},{"id":3839,"verse_key":"37:51","text_indopak_nastaleeq":"قَالَ قَآىِٕلٌ مِّنْهُمْ اِنِّیْ كَانَ لِیْ قَرِیْنٌ ۟ۙ"},{"id":3840,"verse_key":"37:52","text_indopak_nastaleeq":"یَّقُوْلُ اَىِٕنَّكَ لَمِنَ الْمُصَدِّقِیْنَ ۟"},{"id":3841,"verse_key":"37:53","text_indopak_nastaleeq":"ءَاِذَا مِتْنَا وَكُنَّا تُرَابًا وَّعِظَامًا ءَاِنَّا لَمَدِیْنُوْنَ ۟"},{"id":3842,"verse_key":"37:54","text_indopak_nastaleeq":"قَالَ هَلْ اَنْتُمْ مُّطَّلِعُوْنَ ۟"},{"id":3843,"verse_key":"37:55","text_indopak_nastaleeq":"فَاطَّلَعَ فَرَاٰهُ فِیْ سَوَآءِ الْجَحِیْمِ ۟"},{"id":3844,"verse_key":"37:56","text_indopak_nastaleeq":"قَالَ تَاللّٰهِ اِنْ كِدْتَّ لَتُرْدِیْنِ ۟ۙ"},{"id":3845,"verse_key":"37:57","text_indopak_nastaleeq":"وَلَوْلَا نِعْمَةُ رَبِّیْ لَكُنْتُ مِنَ الْمُحْضَرِیْنَ ۟"},{"id":3846,"verse_key":"37:58","text_indopak_nastaleeq":"اَفَمَا نَحْنُ بِمَیِّتِیْنَ ۟ۙ"},{"id":3847,"verse_key":"37:59","text_indopak_nastaleeq":"اِلَّا مَوْتَتَنَا الْاُوْلٰی وَمَا نَحْنُ بِمُعَذَّبِیْنَ ۟"},{"id":3848,"verse_key":"37:60","text_indopak_nastaleeq":"اِنَّ هٰذَا لَهُوَ الْفَوْزُ الْعَظِیْمُ ۟"},{"id":3849,"verse_key":"37:61","text_indopak_nastaleeq":"لِمِثْلِ هٰذَا فَلْیَعْمَلِ الْعٰمِلُوْنَ ۟"},{"id":3850,"verse_key":"37:62","text_indopak_nastaleeq":"اَذٰلِكَ خَیْرٌ نُّزُلًا اَمْ شَجَرَةُ الزَّقُّوْمِ ۟"},{"id":3851,"verse_key":"37:63","text_indopak_nastaleeq":"اِنَّا جَعَلْنٰهَا فِتْنَةً لِّلظّٰلِمِیْنَ ۟"},{"id":3852,"verse_key":"37:64","text_indopak_nastaleeq":"اِنَّهَا شَجَرَةٌ تَخْرُجُ فِیْۤ اَصْلِ الْجَحِیْمِ ۟ۙ"},{"id":3853,"verse_key":"37:65","text_indopak_nastaleeq":"طَلْعُهَا كَاَنَّهٗ رُءُوْسُ الشَّیٰطِیْنِ ۟"},{"id":3854,"verse_key":"37:66","text_indopak_nastaleeq":"فَاِنَّهُمْ لَاٰكِلُوْنَ مِنْهَا فَمَالِـُٔوْنَ مِنْهَا الْبُطُوْنَ ۟ؕ"},{"id":3855,"verse_key":"37:67","text_indopak_nastaleeq":"ثُمَّ اِنَّ لَهُمْ عَلَیْهَا لَشَوْبًا مِّنْ حَمِیْمٍ ۟ۚ"},{"id":3856,"verse_key":"37:68","text_indopak_nastaleeq":"ثُمَّ اِنَّ مَرْجِعَهُمْ لَاۡاِلَی الْجَحِیْمِ ۟"},{"id":3857,"verse_key":"37:69","text_indopak_nastaleeq":"اِنَّهُمْ اَلْفَوْا اٰبَآءَهُمْ ضَآلِّیْنَ ۟ۙ"},{"id":3858,"verse_key":"37:70","text_indopak_nastaleeq":"فَهُمْ عَلٰۤی اٰثٰرِهِمْ یُهْرَعُوْنَ ۟"},{"id":3859,"verse_key":"37:71","text_indopak_nastaleeq":"وَلَقَدْ ضَلَّ قَبْلَهُمْ اَكْثَرُ الْاَوَّلِیْنَ ۟ۙ"},{"id":3860,"verse_key":"37:72","text_indopak_nastaleeq":"وَلَقَدْ اَرْسَلْنَا فِیْهِمْ مُّنْذِرِیْنَ ۟"},{"id":3861,"verse_key":"37:73","text_indopak_nastaleeq":"فَانْظُرْ كَیْفَ كَانَ عَاقِبَةُ الْمُنْذَرِیْنَ ۟ۙ"},{"id":3862,"verse_key":"37:74","text_indopak_nastaleeq":"اِلَّا عِبَادَ اللّٰهِ الْمُخْلَصِیْنَ ۟۠"},{"id":3863,"verse_key":"37:75","text_indopak_nastaleeq":"وَلَقَدْ نَادٰىنَا نُوْحٌ فَلَنِعْمَ الْمُجِیْبُوْنَ ۟ؗۖ"},{"id":3864,"verse_key":"37:76","text_indopak_nastaleeq":"وَنَجَّیْنٰهُ وَاَهْلَهٗ مِنَ الْكَرْبِ الْعَظِیْمِ ۟ؗۖ"},{"id":3865,"verse_key":"37:77","text_indopak_nastaleeq":"وَجَعَلْنَا ذُرِّیَّتَهٗ هُمُ الْبٰقِیْنَ ۟ؗۖ"},{"id":3866,"verse_key":"37:78","text_indopak_nastaleeq":"وَتَرَكْنَا عَلَیْهِ فِی الْاٰخِرِیْنَ ۟ؗۖ"},{"id":3867,"verse_key":"37:79","text_indopak_nastaleeq":"سَلٰمٌ عَلٰی نُوْحٍ فِی الْعٰلَمِیْنَ ۟"},{"id":3868,"verse_key":"37:80","text_indopak_nastaleeq":"اِنَّا كَذٰلِكَ نَجْزِی الْمُحْسِنِیْنَ ۟"},{"id":3869,"verse_key":"37:81","text_indopak_nastaleeq":"اِنَّهٗ مِنْ عِبَادِنَا الْمُؤْمِنِیْنَ ۟"},{"id":3870,"verse_key":"37:82","text_indopak_nastaleeq":"ثُمَّ اَغْرَقْنَا الْاٰخَرِیْنَ ۟"},{"id":3871,"verse_key":"37:83","text_indopak_nastaleeq":"وَاِنَّ مِنْ شِیْعَتِهٖ لَاِبْرٰهِیْمَ ۟ۘ"},{"id":3872,"verse_key":"37:84","text_indopak_nastaleeq":"اِذْ جَآءَ رَبَّهٗ بِقَلْبٍ سَلِیْمٍ ۟"},{"id":3873,"verse_key":"37:85","text_indopak_nastaleeq":"اِذْ قَالَ لِاَبِیْهِ وَقَوْمِهٖ مَاذَا تَعْبُدُوْنَ ۟ۚ"},{"id":3874,"verse_key":"37:86","text_indopak_nastaleeq":"اَىِٕفْكًا اٰلِهَةً دُوْنَ اللّٰهِ تُرِیْدُوْنَ ۟ؕ"},{"id":3875,"verse_key":"37:87","text_indopak_nastaleeq":"فَمَا ظَنُّكُمْ بِرَبِّ الْعٰلَمِیْنَ ۟"},{"id":3876,"verse_key":"37:88","text_indopak_nastaleeq":"فَنَظَرَ نَظْرَةً فِی النُّجُوْمِ ۟ۙ"},{"id":3877,"verse_key":"37:89","text_indopak_nastaleeq":"فَقَالَ اِنِّیْ سَقِیْمٌ ۟"},{"id":3878,"verse_key":"37:90","text_indopak_nastaleeq":"فَتَوَلَّوْا عَنْهُ مُدْبِرِیْنَ ۟"},{"id":3879,"verse_key":"37:91","text_indopak_nastaleeq":"فَرَاغَ اِلٰۤی اٰلِهَتِهِمْ فَقَالَ اَلَا تَاْكُلُوْنَ ۟ۚ"},{"id":3880,"verse_key":"37:92","text_indopak_nastaleeq":"مَا لَكُمْ لَا تَنْطِقُوْنَ ۟"},{"id":3881,"verse_key":"37:93","text_indopak_nastaleeq":"فَرَاغَ عَلَیْهِمْ ضَرْبًا بِالْیَمِیْنِ ۟"},{"id":3882,"verse_key":"37:94","text_indopak_nastaleeq":"فَاَقْبَلُوْۤا اِلَیْهِ یَزِفُّوْنَ ۟"},{"id":3883,"verse_key":"37:95","text_indopak_nastaleeq":"قَالَ اَتَعْبُدُوْنَ مَا تَنْحِتُوْنَ ۟ۙ"},{"id":3884,"verse_key":"37:96","text_indopak_nastaleeq":"وَاللّٰهُ خَلَقَكُمْ وَمَا تَعْمَلُوْنَ ۟"},{"id":3885,"verse_key":"37:97","text_indopak_nastaleeq":"قَالُوا ابْنُوْا لَهٗ بُنْیَانًا فَاَلْقُوْهُ فِی الْجَحِیْمِ ۟"},{"id":3886,"verse_key":"37:98","text_indopak_nastaleeq":"فَاَرَادُوْا بِهٖ كَیْدًا فَجَعَلْنٰهُمُ الْاَسْفَلِیْنَ ۟"},{"id":3887,"verse_key":"37:99","text_indopak_nastaleeq":"وَقَالَ اِنِّیْ ذَاهِبٌ اِلٰی رَبِّیْ سَیَهْدِیْنِ ۟"},{"id":3888,"verse_key":"37:100","text_indopak_nastaleeq":"رَبِّ هَبْ لِیْ مِنَ الصّٰلِحِیْنَ ۟"},{"id":3889,"verse_key":"37:101","text_indopak_nastaleeq":"فَبَشَّرْنٰهُ بِغُلٰمٍ حَلِیْمٍ ۟"},{"id":3890,"verse_key":"37:102","text_indopak_nastaleeq":"فَلَمَّا بَلَغَ مَعَهُ السَّعْیَ قَالَ یٰبُنَیَّ اِنِّیْۤ اَرٰی فِی الْمَنَامِ اَنِّیْۤ اَذْبَحُكَ فَانْظُرْ مَاذَا تَرٰی ؕ قَالَ یٰۤاَبَتِ افْعَلْ مَا تُؤْمَرُ ؗ سَتَجِدُنِیْۤ اِنْ شَآءَ اللّٰهُ مِنَ الصّٰبِرِیْنَ ۟"},{"id":3891,"verse_key":"37:103","text_indopak_nastaleeq":"فَلَمَّاۤ اَسْلَمَا وَتَلَّهٗ لِلْجَبِیْنِ ۟ۚ"},{"id":3892,"verse_key":"37:104","text_indopak_nastaleeq":"وَنَادَیْنٰهُ اَنْ یّٰۤاِبْرٰهِیْمُ ۟ۙ"},{"id":3893,"verse_key":"37:105","text_indopak_nastaleeq":"قَدْ صَدَّقْتَ الرُّءْیَا ۚ اِنَّا كَذٰلِكَ نَجْزِی الْمُحْسِنِیْنَ ۟"},{"id":3894,"verse_key":"37:106","text_indopak_nastaleeq":"اِنَّ هٰذَا لَهُوَ الْبَلٰٓؤُا الْمُبِیْنُ ۟"},{"id":3895,"verse_key":"37:107","text_indopak_nastaleeq":"وَفَدَیْنٰهُ بِذِبْحٍ عَظِیْمٍ ۟"},{"id":3896,"verse_key":"37:108","text_indopak_nastaleeq":"وَتَرَكْنَا عَلَیْهِ فِی الْاٰخِرِیْنَ ۟ۖ"},{"id":3897,"verse_key":"37:109","text_indopak_nastaleeq":"سَلٰمٌ عَلٰۤی اِبْرٰهِیْمَ ۟"},{"id":3898,"verse_key":"37:110","text_indopak_nastaleeq":"كَذٰلِكَ نَجْزِی الْمُحْسِنِیْنَ ۟"},{"id":3899,"verse_key":"37:111","text_indopak_nastaleeq":"اِنَّهٗ مِنْ عِبَادِنَا الْمُؤْمِنِیْنَ ۟"},{"id":3900,"verse_key":"37:112","text_indopak_nastaleeq":"وَبَشَّرْنٰهُ بِاِسْحٰقَ نَبِیًّا مِّنَ الصّٰلِحِیْنَ ۟"},{"id":3901,"verse_key":"37:113","text_indopak_nastaleeq":"وَبٰرَكْنَا عَلَیْهِ وَعَلٰۤی اِسْحٰقَ ؕ وَمِنْ ذُرِّیَّتِهِمَا مُحْسِنٌ وَّظَالِمٌ لِّنَفْسِهٖ مُبِیْنٌ ۟۠"},{"id":3902,"verse_key":"37:114","text_indopak_nastaleeq":"وَلَقَدْ مَنَنَّا عَلٰی مُوْسٰی وَهٰرُوْنَ ۟ۚ"},{"id":3903,"verse_key":"37:115","text_indopak_nastaleeq":"وَنَجَّیْنٰهُمَا وَقَوْمَهُمَا مِنَ الْكَرْبِ الْعَظِیْمِ ۟ۚ"},{"id":3904,"verse_key":"37:116","text_indopak_nastaleeq":"وَنَصَرْنٰهُمْ فَكَانُوْا هُمُ الْغٰلِبِیْنَ ۟ۚ"},{"id":3905,"verse_key":"37:117","text_indopak_nastaleeq":"وَاٰتَیْنٰهُمَا الْكِتٰبَ الْمُسْتَبِیْنَ ۟ۚ"},{"id":3906,"verse_key":"37:118","text_indopak_nastaleeq":"وَهَدَیْنٰهُمَا الصِّرَاطَ الْمُسْتَقِیْمَ ۟ۚ"},{"id":3907,"verse_key":"37:119","text_indopak_nastaleeq":"وَتَرَكْنَا عَلَیْهِمَا فِی الْاٰخِرِیْنَ ۟ۙ"},{"id":3908,"verse_key":"37:120","text_indopak_nastaleeq":"سَلٰمٌ عَلٰی مُوْسٰی وَهٰرُوْنَ ۟"},{"id":3909,"verse_key":"37:121","text_indopak_nastaleeq":"اِنَّا كَذٰلِكَ نَجْزِی الْمُحْسِنِیْنَ ۟"},{"id":3910,"verse_key":"37:122","text_indopak_nastaleeq":"اِنَّهُمَا مِنْ عِبَادِنَا الْمُؤْمِنِیْنَ ۟"},{"id":3911,"verse_key":"37:123","text_indopak_nastaleeq":"وَاِنَّ اِلْیَاسَ لَمِنَ الْمُرْسَلِیْنَ ۟ؕ"},{"id":3912,"verse_key":"37:124","text_indopak_nastaleeq":"اِذْ قَالَ لِقَوْمِهٖۤ اَلَا تَتَّقُوْنَ ۟"},{"id":3913,"verse_key":"37:125","text_indopak_nastaleeq":"اَتَدْعُوْنَ بَعْلًا وَّتَذَرُوْنَ اَحْسَنَ الْخَالِقِیْنَ ۟ۙ"},{"id":3914,"verse_key":"37:126","text_indopak_nastaleeq":"اللّٰهَ رَبَّكُمْ وَرَبَّ اٰبَآىِٕكُمُ الْاَوَّلِیْنَ ۟"},{"id":3915,"verse_key":"37:127","text_indopak_nastaleeq":"فَكَذَّبُوْهُ فَاِنَّهُمْ لَمُحْضَرُوْن