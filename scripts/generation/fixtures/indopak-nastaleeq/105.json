{"verses":[{"id":6189,"verse_key":"105:1","text_indopak_nastaleeq":"اَلَمْ تَرَ كَیْفَ فَعَلَ رَبُّكَ بِاَصْحٰبِ الْفِیْلِ ۟ؕ"},{"id":6190,"verse_key":"105:2","text_indopak_nastaleeq":"اَلَمْ یَجْعَلْ كَیْدَهُمْ فِیْ تَضْلِیْلٍ ۟ۙ"},{"id":6191,"verse_key":"105:3","text_indopak_nastaleeq":"وَّاَرْسَلَ عَلَیْهِمْ طَیْرًا اَبَابِیْلَ ۟ۙ"},{"id":6192,"verse_key":"105:4","text_indopak_nastaleeq":"تَرْمِیْهِمْ بِحِجَارَةٍ مِّنْ سِجِّیْلٍ ۟"},{"id":6193,"verse_key":"105:5","text_indopak_nastaleeq":"فَجَعَلَهُمْ كَعَصْفٍ مَّاْكُوْلٍ ۟۠"}],"meta":{"filters":{"chapter_number":"105"}}}