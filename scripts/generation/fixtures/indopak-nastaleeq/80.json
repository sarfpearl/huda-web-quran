{"verses":[{"id":5759,"verse_key":"80:1","text_indopak_nastaleeq":"عَبَسَ وَتَوَلّٰۤی ۟ۙ"},{"id":5760,"verse_key":"80:2","text_indopak_nastaleeq":"اَنْ جَآءَهُ الْاَعْمٰى ۟ؕ"},{"id":5761,"verse_key":"80:3","text_indopak_nastaleeq":"وَمَا یُدْرِیْكَ لَعَلَّهٗ یَزَّ ۟ۙ"},{"id":5762,"verse_key":"80:4","text_indopak_nastaleeq":"اَوْ یَذَّكَّرُ فَتَنْفَعَهُ الذِّكْرٰى ۟ؕ"},{"id":5763,"verse_key":"80:5","text_indopak_nastaleeq":"اَمَّا مَنِ اسْتَغْنٰى ۟ۙ"},{"id":5764,"verse_key":"80:6","text_indopak_nastaleeq":"فَاَنْتَ لَهٗ تَصَدّٰى ۟ؕ"},{"id":5765,"verse_key":"80:7","text_indopak_nastaleeq":"وَمَا عَلَیْكَ اَلَّا یَزَّكّٰى ۟ؕ"},{"id":5766,"verse_key":"80:8","text_indopak_nastaleeq":"وَاَمَّا مَنْ جَآءَكَ یَسْعٰى ۟ۙ"},{"id":5767,"verse_key":"80:9","text_indopak_nastaleeq":"وَهُوَ یَخْشٰى ۟ۙ"},{"id":5768,"verse_key":"80:10","text_indopak_nastaleeq":"فَاَنْتَ عَنْهُ تَلَهّٰى ۟ۚ"},{"id":5769,"verse_key":"80:11","text_indopak_nastaleeq":"كَلَّاۤ اِنَّهَا تَذْكِرَةٌ ۟ۚ"},{"id":5770,"verse_key":"80:12","text_indopak_nastaleeq":"فَمَنْ شَآءَ ذَكَرَهٗ ۟ۘ"},{"id":5771,"verse_key":"80:13","text_indopak_nastaleeq":"فِیْ صُحُفٍ مُّكَرَّمَةٍ ۟ۙ"},{"id":5772,"verse_key":"80:14","text_indopak_nastaleeq":"مَّرْفُوْعَةٍ مُّطَهَّرَةٍۭ ۟ۙ"},{"id":5773,"verse_key":"80:15","text_indopak_nastaleeq":"بِاَیْدِیْ سَفَرَةٍ ۟ۙ"},{"id":5774,"verse_key":"80:16","text_indopak_nastaleeq":"كِرَامٍ بَرَرَةٍ ۟ؕ"},{"id":5775,"verse_key":"80:17","text_indopak_nastaleeq":"قُتِلَ الْاِنْسَانُ مَاۤ اَكْفَرَهٗ ۟ؕ"},{"id":5776,"verse_key":"80:18","text_indopak_nastaleeq":"مِنْ اَیِّ شَیْءٍ خَلَقَهٗ ۟ؕ"},{"id":5777,"verse_key":"80:19","text_indopak_nastaleeq":"مِنْ نُّطْفَةٍ ؕ خَلَقَهٗ فَقَدَّرَهٗ ۟ۙ"},{"id":5778,"verse_key":"80:20","text_indopak_nastaleeq":"ثُمَّ السَّبِیْلَ یَسَّرَهٗ ۟ۙ"},{"id":5779,"verse_key":"80:21","text_indopak_nastaleeq":"ثُمَّ اَمَاتَهٗ فَاَقْبَرَهٗ ۟ۙ"},{"id":5780,"verse_key":"80:22","text_indopak_nastaleeq":"ثُمَّ اِذَا شَآءَ اَنْشَرَهٗ ۟ؕ"},{"id":5781,"v