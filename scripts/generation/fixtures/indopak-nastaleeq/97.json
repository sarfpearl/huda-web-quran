{"verses":[{"id":6126,"verse_key":"97:1","text_indopak_nastaleeq":"اِنَّاۤ اَنْزَلْنٰهُ فِیْ لَیْلَةِ الْقَدْرِ ۟ۚۖ"},{"id":6127,"verse_key":"97:2","text_indopak_nastaleeq":"وَمَاۤ اَدْرٰىكَ مَا لَیْلَةُ الْقَدْرِ ۟ؕ"},{"id":6128,"verse_key":"97:3","text_indopak_nastaleeq":"لَیْلَةُ الْقَدْرِ ۙ۬ خَیْرٌ مِّنْ اَلْفِ شَهْرٍ ۟ؕؔ"},{"id":6129,"verse_key":"97:4","text_indopak_nastaleeq":"تَنَزَّلُ الْمَلٰٓىِٕكَةُ وَالرُّوْحُ فِیْهَا بِاِذْنِ رَبِّهِمْ ۚ مِنْ كُلِّ اَمْرٍ ۟ۙۛ"},{"id":6130,"verse_key":"97:5","text_indopak_nastaleeq":"سَلٰمٌ ۛ۫ هِیَ حَتّٰی مَطْلَعِ الْفَجْرِ ۟۠"}],"meta":{"filters":{"chapter_number":"97"}}}