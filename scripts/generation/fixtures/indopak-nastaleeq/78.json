{"verses":[{"id":5673,"verse_key":"78:1","text_indopak_nastaleeq":"عَمَّ یَتَسَآءَلُوْنَ ۟ۚ"},{"id":5674,"verse_key":"78:2","text_indopak_nastaleeq":"عَنِ النَّبَاِ الْعَظِیْمِ ۟ۙ"},{"id":5675,"verse_key":"78:3","text_indopak_nastaleeq":"الَّذِیْ هُمْ فِیْهِ مُخْتَلِفُوْنَ ۟ؕ"},{"id":5676,"verse_key":"78:4","text_indopak_nastaleeq":"كَلَّا سَیَعْلَمُوْنَ ۟ۙ"},{"id":5677,"verse_key":"78:5","text_indopak_nastaleeq":"ثُمَّ كَلَّا سَیَعْلَمُوْنَ ۟"},{"id":5678,"verse_key":"78:6","text_indopak_nastaleeq":"اَلَمْ نَجْعَلِ الْاَرْضَ مِهٰدًا ۟ۙ"},{"id":5679,"verse_key":"78:7","text_indopak_nastaleeq":"وَّالْجِبَالَ اَوْتَادًا ۟"},{"id":5680,"verse_key":"78:8","text_indopak_nastaleeq":"وَّخَلَقْنٰكُمْ اَزْوَاجًا ۟ۙ"},{"id":5681,"verse_key":"78:9","text_indopak_nastaleeq":"وَّجَعَلْنَا نَوْمَكُمْ سُبَاتًا ۟ۙ"},{"id":5682,"verse_key":"78:10","text_indopak_nastaleeq":"وَّجَعَلْنَا الَّیْلَ لِبَاسًا ۟ۙ"},{"id":5683,"verse_key":"78:11","text_indopak_nastaleeq":"وَّجَعَلْنَا النَّهَارَ مَعَاشًا ۪۟"},{"id":5684,"verse_key":"78:12","text_indopak_nastaleeq":"وَّبَنَیْنَا فَوْقَكُمْ سَبْعًا شِدَادًا ۟ۙ"},{"id":5685,"verse_key":"78:13","text_indopak_nastaleeq":"وَّجَعَلْنَا سِرَاجًا وَّهَّاجًا ۟"},{"id":5686,"verse_key":"78:14","text_indopak_nastaleeq":"وَّاَنْزَلْنَا مِنَ الْمُعْصِرٰتِ مَآءً ثَجَّاجًا ۟ۙ"},{"id":5687,"verse_key":"78:15","text_indopak_nastaleeq":"لِّنُخْرِجَ بِهٖ حَبًّا وَّنَبَاتًا ۟ۙ"},{"id":5688,"verse_key":"78:16","text_indopak_nastaleeq":"وَّجَنّٰتٍ اَلْفَافًا ۟ؕ"},{"id":5689,"verse_key":"78:17","text_indopak_nastaleeq":"اِنَّ یَوْمَ الْفَصْلِ كَانَ مِیْقَاتًا ۟ۙ"},{"id":5690,"verse_key":"78:18","text_indopak_nastaleeq":"یَّوْمَ یُنْفَخُ فِی الصُّوْرِ فَتَاْتُوْنَ اَفْوَاجًا ۟ۙ"},{"id":5691,"verse_key":"78:19","text_indopak_nastaleeq":"وَّفُتِحَتِ السَّمَآءُ فَكَانَتْ اَبْوَابًا ۟ۙ"},{"id":5692,"verse_key":"78:20","text_indopak_nastaleeq":"وَّسُیِّرَتِ الْجِبَالُ فَكَانَتْ سَرَابًا ۟ؕ"},{"id":5693,"verse_key":"78:21","text_indopak_nastaleeq":"اِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًا ۟"},{"id":5694,"verse_key":"78:22","text_indopak_nastaleeq":"لِّلطَّاغِیْنَ مَاٰبًا ۟ۙ"},{"id":5695,"verse_key":"78:23","text_indopak_nastaleeq":"لّٰبِثِیْنَ فِیْهَاۤ اَحْقَابًا ۟ۚ"},{"id":5696,"verse_key":"78:24","text_indopak_nastaleeq":"لَا یَذُوْقُوْنَ فِیْهَا بَرْدًا وَّلَا شَرَابًا ۟ۙ"},{"id":5697,"verse_key":"78:25","text_indopak_nastaleeq":"اِلَّا حَمِیْمًا وَّغَسَّاقًا ۟ۙ"},{"id":5698,"verse_key":"78:26","text_indopak_nastaleeq":"جَزَآءً وِّفَاقًا ۟ؕ"},{"id":5699,"verse_key":"78:27","text_indopak_nastaleeq":"اِنَّهُمْ كَانُوْا لَا یَرْجُوْنَ حِسَابًا ۟ۙ"},{"id":5700,"verse_key":"78:28","text_indopak_nastaleeq":"وَّكَذَّبُوْا بِاٰیٰتِنَا كِذَّابًا ۟ؕ"},{"id":5701,"verse_key":"78:29","text_indopak_nastaleeq":"وَكُلَّ شَیْءٍ اَحْصَیْنٰهُ كِتٰبًا ۟ۙ"},{"id":5702,"verse_key":"78:30","text_indopak_nastaleeq":"فَذُوْقُوْا فَلَنْ نَّزِیْدَكُمْ اِلَّا عَذَابًا ۟۠"},{"id":5703,"verse_key":"78:31","text_indopak_nastaleeq":"اِنَّ لِلْمُتَّقِیْنَ مَفَازًا ۟ۙ"},{"id":5704,"verse_key":"78:32","text_indopak_nastaleeq":"حَدَآىِٕقَ وَاَعْنَابًا ۟ۙ"},{"id":5705,"verse_key":"78:33","text_indopak_nastaleeq":"وَّكَوَاعِبَ اَتْرَابًا ۟ۙ"},{"id":5706,"verse_key":"78:34","text_indopak_nastaleeq":"وَّكَاْسًا دِهَاقًا ۟ؕ"},{"id":5707,"verse_key":"78:35","text_indopak_nastaleeq":"لَا یَسْمَعُوْنَ فِیْهَا لَغْوًا وَّلَا كِذّٰبًا ۟ۚ"},{"id":5708,"verse_key":"78:36","text_indopak_nastaleeq":"جَزَآءً مِّنْ رَّبِّكَ عَطَآءً حِسَابًا ۟ۙ"},{"id":5709,"verse_key":"78:37","text_indopak_nastaleeq":"رَّبِّ السَّمٰوٰتِ وَالْاَرْضِ وَمَا بَیْنَهُمَا الرَّحْمٰنِ لَا یَمْلِكُوْنَ مِنْهُ خِطَابًا ۟ۚ"},{"id":5710,"verse_key":"78:38","text_indopak_nastaleeq":"یَوْمَ یَقُوْمُ الرُّوْحُ وَالْمَلٰٓىِٕكَةُ صَفًّا ۙۗؕ لَّا یَتَكَلَّمُوْنَ اِلَّا مَنْ اَذِنَ لَهُ الرَّحْمٰنُ وَقَالَ صَوَابًا ۟"},{"id":5711,"verse_key":"78:39","text_indopak_nastaleeq":"ذٰلِكَ الْیَوْمُ الْحَقُّ ۚ فَمَنْ شَآءَ اتَّخَذَ اِلٰی رَبِّهٖ مَاٰبًا ۟"},{"id":5712,"verse_key":"78:40","text_indopak_nastaleeq":"اِنَّاۤ اَنْذَرْنٰكُمْ عَذَابًا قَرِیْبًا ۖۚ۬ یَّوْمَ یَنْظُرُ الْمَرْءُ مَا قَدَّمَتْ یَدٰهُ وَیَقُوْلُ الْكٰفِرُ یٰلَیْتَنِیْ كُنْتُ تُرٰبًا ۟۠"}],"meta":{"filters":{"chapter_number":"78"}}}