{"verses":[{"id":5324,"verse_key":"69:1","text_indopak_nastaleeq":"اَلْحَآقَّةُ ۟ۙ"},{"id":5325,"verse_key":"69:2","text_indopak_nastaleeq":"مَا الْحَآقَّةُ ۟ۚ"},{"id":5326,"verse_key":"69:3","text_indopak_nastaleeq":"وَمَاۤ اَدْرٰىكَ مَا الْحَآقَّةُ ۟ؕ"},{"id":5327,"verse_key":"69:4","text_indopak_nastaleeq":"كَذَّبَتْ ثَمُوْدُ وَعَادٌ بِالْقَارِعَةِ ۟"},{"id":5328,"verse_key":"69:5","text_indopak_nastaleeq":"فَاَمَّا ثَمُوْدُ فَاُهْلِكُوْا بِالطَّاغِیَةِ ۟"},{"id":5329,"verse_key":"69:6","text_indopak_nastaleeq":"وَاَمَّا عَادٌ فَاُهْلِكُوْا بِرِیْحٍ صَرْصَرٍ عَاتِیَةٍ ۟ۙ"},{"id":5330,"verse_key":"69:7","text_indopak_nastaleeq":"سَخَّرَهَا عَلَیْهِمْ سَبْعَ لَیَالٍ وَّثَمٰنِیَةَ اَیَّامٍ ۙ حُسُوْمًا فَتَرَی الْقَوْمَ فِیْهَا صَرْعٰی ۙ كَاَنَّهُمْ اَعْجَازُ نَخْلٍ خَاوِیَةٍ ۟ۚ"},{"id":5331,"verse_key":"69:8","text_indopak_nastaleeq":"فَهَلْ تَرٰی لَهُمْ مِّنْ بَاقِیَةٍ ۟"},{"id":5332,"verse_key":"69:9","text_indopak_nastaleeq":"وَجَآءَ فِرْعَوْنُ وَمَنْ قَبْلَهٗ وَالْمُؤْتَفِكٰتُ بِالْخَاطِئَةِ ۟ۚ"},{"id":5333,"verse_key":"69:10","text_indopak_nastaleeq":"فَعَصَوْا رَسُوْلَ رَبِّهِمْ فَاَخَذَهُمْ اَخْذَةً رَّابِیَةً ۟"},{"id":5334,"verse_key":"69:11","text_indopak_nastaleeq":"اِنَّا لَمَّا طَغَا الْمَآءُ حَمَلْنٰكُمْ فِی الْجَارِیَةِ ۟ۙ"},{"id":5335,"verse_key":"69:12","text_indopak_nastaleeq":"لِنَجْعَلَهَا لَكُمْ تَذْكِرَةً وَّتَعِیَهَاۤ اُذُنٌ وَّاعِیَةٌ ۟"},{"id":5336,"verse_key":"69:13","text_indopak_nastaleeq":"فَاِذَا نُفِخَ فِی الصُّوْرِ نَفْخَةٌ وَّاحِدَةٌ ۟ۙ"},{"id":5337,"verse_key":"69:14","text_indopak_nastaleeq":"وَّحُمِلَتِ الْاَرْضُ وَالْجِبَالُ فَدُكَّتَا دَكَّةً وَّاحِدَةً ۟ۙ"},{"id":5338,"verse_key":"69:15","text_indopak_nastaleeq":"فَیَوْمَىِٕذٍ وَّقَعَتِ الْوَاقِعَةُ ۟ۙ"},{"id":5339,"verse_key":"69:16","text_indopak_nastaleeq":"وَانْشَقَّتِ السَّمَآءُ فَهِیَ یَوْمَىِٕذٍ وَّاهِیَةٌ ۟ۙ"},{"id":5340,"verse_key":"69:17","text_indopak_nastaleeq":"وَّالْمَلَكُ عَلٰۤی اَرْجَآىِٕهَا ؕ وَیَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ یَوْمَىِٕذٍ ثَمٰنِیَةٌ ۟ؕ"},{"id":5341,"verse_key":"69:18","text_indopak_nastaleeq":"یَوْمَىِٕذٍ تُعْرَضُوْنَ لَا تَخْفٰی مِنْكُمْ خَافِیَةٌ ۟"},{"id":5342,"verse_key":"69:19","text_indopak_nastaleeq":"فَاَمَّا مَنْ اُوْتِیَ كِتٰبَهٗ بِیَمِیْنِهٖ ۙ فَیَقُوْلُ هَآؤُمُ اقْرَءُوْا كِتٰبِیَهْ ۟ۚ"},{"id":5343,"verse_key":"69:20","text_indopak_nastaleeq":"اِنِّیْ ظَنَنْتُ اَنِّیْ مُلٰقٍ حِسَابِیَهْ ۟ۚ"},{"id":5344,"verse_key":"69:21","text_indopak_nastaleeq":"فَهُوَ فِیْ عِیْشَةٍ رَّاضِیَةٍ ۟ۙ"},{"id":5345,"verse_key":"69:22","text_indopak_nastaleeq":"فِیْ جَنَّةٍ عَالِیَةٍ ۟ۙ"},{"id":5346,"verse_key":"69:23","text_indopak_nastaleeq":"قُطُوْفُهَا دَانِیَةٌ ۟"},{"id":5347,"verse_key":"69:24","text_indopak_nastaleeq":"كُلُوْا وَاشْرَبُوْا هَنِیْٓـًٔا بِمَاۤ اَسْلَفْتُمْ فِی الْاَیَّامِ الْخَالِیَةِ ۟"},{"id":5348,"verse_key":"69:25","text_indopak_nastaleeq":"وَاَمَّا مَنْ اُوْتِیَ كِتٰبَهٗ بِشِمَالِهٖ ۙ۬ فَیَقُوْلُ یٰلَیْتَنِیْ لَمْ اُوْتَ كِتٰبِیَهْ ۟ۚ"},{"id":5349,"verse_key":"69:26","text_indopak_nastaleeq":"وَلَمْ اَدْرِ مَا حِسَابِیَهْ ۟ۚ"},{"id":5350,"verse_key":"69:27","text_indopak_nastaleeq":"یٰلَیْتَهَا كَانَتِ الْقَاضِیَةَ ۟ۚ"},{"id":5351,"verse_key":"69:28","text_indopak_nastaleeq":"مَاۤ اَغْنٰی عَنِّیْ مَالِیَهْ ۟ۚ"},{"id":5352,"verse_key":"69:29","text_indopak_nastaleeq":"هَلَكَ عَنِّیْ سُلْطٰنِیَهْ ۟ۚ"},{"id":5353,"verse_key":"69:30","text_indopak_nastaleeq":"خُذُوْهُ فَغُلُّوْهُ ۟ۙ"},{"id":5354,"verse_key":"69:31","text_indopak_nastaleeq":"ثُمَّ الْجَحِیْمَ صَلُّوْهُ ۟ۙ"},{"id":5355,"verse_key":"69:32","text_indopak_nastaleeq":"ثُمَّ فِیْ سِلْسِلَةٍ ذَرْعُهَا سَبْعُوْنَ ذِرَاعًا فَاسْلُكُوْهُ ۟ؕ"},{"id":5356,"verse_key":"69:33","text_indopak_nastaleeq":"اِنَّهٗ كَانَ لَا یُؤْمِنُ بِاللّٰهِ الْعَظِیْمِ ۟ۙ"},{"id":5357,"verse_key":"69:34","text_indopak_nastaleeq":"وَلَا یَحُضُّ عَلٰی طَعَامِ الْمِسْكِیْنِ ۟ؕ"},{"id":5358,"verse_key":"69:35","text_indopak_nastaleeq":"فَلَیْسَ لَهُ الْیَوْمَ هٰهُنَا حَمِیْمٌ ۟ۙ"},{"id":5359,"verse_key":"69:36","text_indopak_nastaleeq":"وَّلَا طَعَامٌ اِلَّا مِنْ غِسْلِیْنٍ ۟ۙ"},{"id":5360,"verse_key":"69:37","text_indopak_nastaleeq":"لَّا یَاْكُلُهٗۤ اِلَّا الْخَاطِـُٔوْنَ ۟۠"},{"id":5361,"verse_key":"69:38","text_indopak_nastaleeq":"فَلَاۤ اُقْسِمُ بِمَا تُبْصِرُوْنَ ۟ۙ"},{"id":5362,"verse_key":"69:39","text_indopak_nastaleeq":"وَمَا لَا تُبْصِرُوْنَ ۟ۙ"},{"id":5363,"verse_key":"69:40","text_indopak_nastaleeq":"اِنَّهٗ لَقَوْلُ رَسُوْلٍ كَرِیْمٍ ۟ۚۙ"},{"id":5364,"verse_key":"69:41","text_indopak_nastaleeq":"وَّمَا هُوَ بِقَوْلِ شَاعِرٍ ؕ قَلِیْلًا مَّا تُؤْمِنُوْنَ ۟ۙ"},{"id":5365,"verse_key":"69:42","text_indopak_nastaleeq":"وَلَا بِقَوْلِ كَاهِنٍ ؕ قَلِیْلًا مَّا تَذَكَّرُوْنَ ۟ؕ"},{"id":5366,"verse_key":"69:43","text_indopak_nastaleeq":"تَنْزِیْلٌ مِّنْ رَّبِّ الْعٰلَمِیْنَ ۟"},{"id":5367,"verse_key":"69:44","text_indopak_nastaleeq":"وَلَوْ تَقَوَّلَ عَلَیْنَا بَعْضَ الْاَقَاوِیْلِ ۟ۙ"},{"id":5368,"verse_key":"69:45","text_indopak_nastaleeq":"لَاَخَذْنَا مِنْهُ بِالْیَمِیْنِ ۟ۙ"},{"id":5369,"verse_key":"69:46","text_indopak_nastaleeq":"ثُمَّ لَقَطَعْنَا مِنْهُ الْوَتِیْنَ ۟ؗۖ"},{"id":5370,"verse_key":"69:47","text_indopak_nastaleeq":"فَمَا مِنْكُمْ مِّنْ اَحَدٍ عَنْهُ حٰجِزِیْنَ ۟"},{"id":5371,"verse_key":"69:48","text_indopak_nastaleeq":"وَاِنَّهٗ لَتَذْكِرَةٌ لِّلْمُتَّقِیْنَ ۟"},{"id":5372,"verse_key":"69:49","text_indopak_nastaleeq":"وَاِنَّا لَنَعْلَمُ اَنَّ مِنْكُمْ مُّكَذِّبِیْنَ ۟"},{"id":5373,"verse_key":"69:50","text_indopak_nastaleeq":"وَاِنَّهٗ لَحَسْرَةٌ عَلَی الْكٰفِرِیْنَ ۟"},{"id":5374,"verse_key":"69:51","text_indopak_nastaleeq":"وَاِنَّهٗ لَحَقُّ الْیَقِیْنِ ۟"},{"id":5375,"verse_key":"69:52","text_indopak_nastaleeq":"فَسَبِّحْ بِاسْمِ رَبِّكَ الْعَظِیْمِ ۟۠"}],"meta":{"filters":{"chapter_number":"69"}}}