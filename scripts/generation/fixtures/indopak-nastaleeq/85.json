{"verses":[{"id":5910,"verse_key":"85:1","text_indopak_nastaleeq":"وَالسَّمَآءِ ذَاتِ الْبُرُوْجِ ۟ۙ"},{"id":5911,"verse_key":"85:2","text_indopak_nastaleeq":"وَالْیَوْمِ الْمَوْعُوْدِ ۟ۙ"},{"id":5912,"verse_key":"85:3","text_indopak_nastaleeq":"وَشَاهِدٍ وَّمَشْهُوْدٍ ۟ؕ"},{"id":5913,"verse_key":"85:4","text_indopak_nastaleeq":"قُتِلَ اَصْحٰبُ الْاُخْدُوْدِ ۟ۙ"},{"id":5914,"verse_key":"85:5","text_indopak_nastaleeq":"النَّارِ ذَاتِ الْوَقُوْدِ ۟ۙ"},{"id":5915,"verse_key":"85:6","text_indopak_nastaleeq":"اِذْ هُمْ عَلَیْهَا قُعُوْدٌ ۟ۙ"},{"id":5916,"verse_key":"85:7","text_indopak_nastaleeq":"وَّهُمْ عَلٰی مَا یَفْعَلُوْنَ بِالْمُؤْمِنِیْنَ شُهُوْدٌ ۟ؕ"},{"id":5917,"verse_key":"85:8","text_indopak_nastaleeq":"وَمَا نَقَمُوْا مِنْهُمْ اِلَّاۤ اَنْ یُّؤْمِنُوْا بِاللّٰهِ الْعَزِیْزِ الْحَمِیْدِ ۟ۙ"},{"id":5918,"verse_key":"85:9","text_indopak_nastaleeq":"الَّذِیْ لَهٗ مُلْكُ السَّمٰوٰتِ وَالْاَرْضِ ؕ وَاللّٰهُ عَلٰی كُلِّ شَیْءٍ شَهِیْدٌ ۟ؕ"},{"id":5919,"verse_key":"85:10","text_indopak_nastaleeq":"اِنَّ الَّذِیْنَ فَتَنُوا الْمُؤْمِنِیْنَ وَالْمُؤْمِنٰتِ ثُمَّ لَمْ یَتُوْبُوْا فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ الْحَرِیْقِ ۟ؕ"},{"id":5920,"verse_key":"85:11","text_indopak_nastaleeq":"اِنَّ الَّذِیْنَ اٰمَنُوْا وَعَمِلُوا الصّٰلِحٰتِ لَهُمْ جَنّٰتٌ تَجْرِیْ مِنْ تَحْتِهَا الْاَنْهٰرُ ؔؕ۬ ذٰلِكَ الْفَوْزُ الْكَبِیْرُ ۟ؕ"},{"id":5921,"verse_key":"85:12","text_indopak_nastaleeq":"اِنَّ بَطْشَ رَبِّكَ لَشَدِیْدٌ ۟ؕ"},{"id":5922,"verse_key":"85:13","text_indopak_nastaleeq":"اِنَّهٗ هُوَ یُبْدِئُ وَیُعِیْدُ ۟ۚ"},{"id":5923,"verse_key":"85:14","text_indopak_nastaleeq":"وَهُوَ الْغَفُوْرُ الْوَدُوْدُ ۟ۙ"},{"id":5924,"verse_key":"85:15","text_indopak_nastaleeq":"ذُو الْعَرْشِ الْمَجِیْدُ ۟ۙ"},{"id":5925,"verse_key":"85:16","text_indopak_nastaleeq":"فَعَّالٌ لِّمَا یُرِیْدُ ۟ؕ"},{"id":5926,"verse_key":"85:17","text_indopak_nastaleeq":"هَلْ اَتٰىكَ حَدِیْثُ الْجُنُوْدِ ۟ۙ"},{"id":5927,"verse_key":"85:18","text_indopak_nastaleeq":"فِرْعَوْنَ وَثَمُوْدَ ۟ؕ"},{"id":5928,"verse_key":"85:19","text_indopak_nastaleeq":"بَلِ الَّذِیْنَ كَفَرُوْا فِیْ تَكْذِیْبٍ ۟ۙ"},{"id":5929,"verse_key":"85:20","text_indopak_nastaleeq":"وَّاللّٰهُ مِنْ وَّرَآىِٕهِمْ مُّحِیْطٌ ۟ۚ"},{"id":5930,"verse_key":"85:21","text_indopak_nastaleeq":"بَلْ هُوَ قُرْاٰنٌ مَّجِیْدٌ ۟ۙ"},{"id":5931,"verse_key":"85:22","text_indopak_nastaleeq":"فِیْ لَوْحٍ مَّحْفُوْظٍ ۟۠"}],"meta":{"filters":{"chapter_number":"85"}}}