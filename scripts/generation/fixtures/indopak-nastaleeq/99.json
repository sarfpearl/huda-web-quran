{"verses":[{"id":6139,"verse_key":"99:1","text_indopak_nastaleeq":"اِذَا زُلْزِلَتِ الْاَرْضُ زِلْزَالَهَا ۟ۙ"},{"id":6140,"verse_key":"99:2","text_indopak_nastaleeq":"وَاَخْرَجَتِ الْاَرْضُ اَثْقَالَهَا ۟ۙ"},{"id":6141,"verse_key":"99:3","text_indopak_nastaleeq":"وَقَالَ الْاِنْسَانُ مَا لَهَا ۟ۚ"},{"id":6142,"verse_key":"99:4","text_indopak_nastaleeq":"یَوْمَىِٕذٍ تُحَدِّثُ اَخْبَارَهَا ۟ؕ"},{"id":6143,"verse_key":"99:5","text_indopak_nastaleeq":"بِاَنَّ رَبَّكَ اَوْحٰی لَهَا ۟ؕ"},{"id":6144,"verse_key":"99:6","text_indopak_nastaleeq":"یَوْمَىِٕذٍ یَّصْدُرُ النَّاسُ اَشْتَاتًا ۙ۬ لِّیُرَوْا اَعْمَالَهُمْ ۟ؕ"},{"id":6145,"verse_key":"99:7","text_indopak_nastaleeq":"فَمَنْ یَّعْمَلْ مِثْقَالَ ذَرَّةٍ خَیْرًا یَّرَهٗ ۟ؕ"},{"id":6146,"verse_key":"99:8","text_indopak_nastaleeq":"وَمَنْ یَّعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا یَّرَهٗ ۟۠"}],"meta":{"filters":{"chapter_number":"99"}}}