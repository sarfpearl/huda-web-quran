{"verses":[{"id":5949,"verse_key":"87:1","text_indopak_nastaleeq":"سَبِّحِ اسْمَ رَبِّكَ الْاَعْلَی ۟ۙ"},{"id":5950,"verse_key":"87:2","text_indopak_nastaleeq":"الَّذِیْ خَلَقَ فَسَوّٰی ۟"},{"id":5951,"verse_key":"87:3","text_indopak_nastaleeq":"وَالَّذِیْ قَدَّرَ فَهَدٰی ۟"},{"id":5952,"verse_key":"87:4","text_indopak_nastaleeq":"وَالَّذِیْۤ اَخْرَجَ الْمَرْعٰی ۟"},{"id":5953,"verse_key":"87:5","text_indopak_nastaleeq":"فَجَعَلَهٗ غُثَآءً اَحْوٰی ۟ؕ"},{"id":5954,"verse_key":"87:6","text_indopak_nastaleeq":"سَنُقْرِئُكَ فَلَا تَنْسٰۤی ۟ۙ"},{"id":5955,"verse_key":"87:7","text_indopak_nastaleeq":"اِلَّا مَا شَآءَ اللّٰهُ ؕ اِنَّهٗ یَعْلَمُ الْجَهْرَ وَمَا یَخْفٰی ۟ؕ"},{"id":5956,"verse_key":"87:8","text_indopak_nastaleeq":"وَنُیَسِّرُكَ لِلْیُسْرٰی ۟ۚۖ"},{"id":5957,"verse_key":"87:9","text_indopak_nastaleeq":"فَذَكِّرْ اِنْ نَّفَعَتِ الذِّكْرٰی ۟ؕ"},{"id":5958,"verse_key":"87:10","text_indopak_nastaleeq":"سَیَذَّكَّرُ مَنْ یَّخْشٰی ۟ۙ"},{"id":5959,"verse_key":"87:11","text_indopak_nastaleeq":"وَیَتَجَنَّبُهَا الْاَشْقَی ۟ۙ"},{"id":5960,"verse_key":"87:12","text_indopak_nastaleeq":"الَّذِیْ یَصْلَی النَّارَ الْكُبْرٰی ۟ۚ"},{"id":5961,"verse_key":"87:13","text_indopak_nastaleeq":"ثُمَّ لَا یَمُوْتُ فِیْهَا وَلَا یَحْیٰی ۟ؕ"},{"id":5962,"verse_key":"87:14","text_indopak_nastaleeq":"قَدْ اَفْلَحَ مَنْ تَزَكّٰی ۟ۙ"},{"id":5963,"verse_key":"87:15","text_indopak_nastaleeq":"وَذَكَرَ اسْمَ رَبِّهٖ فَصَلّٰی ۟ؕ"},{"id":5964,"verse_key":"87:16","text_indopak_nastaleeq":"بَلْ تُؤْثِرُوْنَ الْحَیٰوةَ الدُّنْیَا ۟ۚۖ"},{"id":5965,"verse_key":"87:17","text_indopak_nastaleeq":"وَالْاٰخِرَةُ خَیْرٌ وَّاَبْقٰی ۟ؕ"},{"id":5966,"verse_key":"87:18","text_indopak_nastaleeq":"اِنَّ هٰذَا لَفِی الصُّحُفِ الْاُوْلٰی ۟ۙ"},{"id":5967,"verse_key":"87:19","text_indopak_nastaleeq":"صُحُفِ اِبْرٰهِیْمَ وَمُوْسٰی ۟۠"}],"meta":{"filters":{"chapter_number":"87"}}}