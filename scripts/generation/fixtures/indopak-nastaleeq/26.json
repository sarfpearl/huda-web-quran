ext_indopak_nastaleeq":"مَاۤ اَنْتَ اِلَّا بَشَرٌ مِّثْلُنَا ۖۚ فَاْتِ بِاٰیَةٍ اِنْ كُنْتَ مِنَ الصّٰدِقِیْنَ ۟"},{"id":3087,"verse_key":"26:155","text_indopak_nastaleeq":"قَالَ هٰذِهٖ نَاقَةٌ لَّهَا شِرْبٌ وَّلَكُمْ شِرْبُ یَوْمٍ مَّعْلُوْمٍ ۟ۚ"},{"id":3088,"verse_key":"26:156","text_indopak_nastaleeq":"وَلَا تَمَسُّوْهَا بِسُوْٓءٍ فَیَاْخُذَكُمْ عَذَابُ یَوْمٍ عَظِیْمٍ ۟"},{"id":3089,"verse_key":"26:157","text_indopak_nastaleeq":"فَعَقَرُوْهَا فَاَصْبَحُوْا نٰدِمِیْنَ ۟ۙ"},{"id":3090,"verse_key":"26:158","text_indopak_nastaleeq":"فَاَخَذَهُمُ الْعَذَابُ ؕ اِنَّ فِیْ ذٰلِكَ لَاٰیَةً ؕ وَمَا كَانَ اَكْثَرُهُمْ مُّؤْمِنِیْنَ ۟"},{"id":3091,"verse_key":"26:159","text_indopak_nastaleeq":"وَاِنَّ رَبَّكَ لَهُوَ الْعَزِیْزُ الرَّحِیْمُ ۟۠"},{"id":3092,"verse_key":"26:160","text_indopak_nastaleeq":"كَذَّبَتْ قَوْمُ لُوْطِ لْمُرْسَلِیْنَ ۟ۚۖ"},{"id":3093,"verse_key":"26:161","text_indopak_nastaleeq":"اِذْ قَالَ لَهُمْ اَخُوْهُمْ لُوْطٌ اَلَا تَتَّقُوْنَ ۟ۚ"},{"id":3094,"verse_key":"26:162","text_indopak_nastaleeq":"اِنِّیْ لَكُمْ رَسُوْلٌ اَمِیْنٌ ۟ۙ"},{"id":3095,"verse_key":"26:163","text_indopak_nastaleeq":"فَاتَّقُوا اللّٰهَ وَاَطِیْعُوْنِ ۟ۚ"},{"id":3096,"verse_key":"26:164","text_indopak_nastaleeq":"وَمَاۤ اَسْـَٔلُكُمْ عَلَیْهِ مِنْ اَجْرٍ ۚ اِنْ اَجْرِیَ اِلَّا عَلٰی رَبِّ الْعٰلَمِیْنَ ۟ؕ"},{"id":3097,"verse_key":"26:165","text_indopak_nastaleeq":"اَتَاْتُوْنَ الذُّكْرَانَ مِنَ الْعٰلَمِیْنَ ۟ۙ"},{"id":3098,"verse_key":"26:166","text_indopak_nastaleeq":"وَتَذَرُوْنَ مَا خَلَقَ لَكُمْ رَبُّكُمْ مِّنْ اَزْوَاجِكُمْ ؕ بَلْ اَنْتُمْ قَوْمٌ عٰدُوْنَ ۟"},{"id":3099,"verse_key":"26:167","text_indopak_nastaleeq":"قَالُوْا لَىِٕنْ لَّمْ تَنْتَهِ یٰلُوْطُ لَتَكُوْنَنَّ مِنَ الْمُخْرَجِیْنَ ۟"},{"id":3100,"verse_key":"26:168","text_indopak_nastaleeq":"قَالَ اِنِّیْ لِعَمَلِكُمْ مِّنَ الْقَالِیْنَ ۟ؕ"},{"id":3101,"verse_key":"26:169","text_indopak_nastaleeq":"رَبِّ نَجِّنِیْ وَاَهْلِیْ مِمَّا یَعْمَلُوْنَ ۟"},{"id":3102,"verse_key":"26:170","text_indopak_nastaleeq":"فَنَجَّیْنٰهُ وَاَهْلَهٗۤ اَجْمَعِیْنَ ۟ۙ"},{"id":3103,"verse_key":"26:171","text_indopak_nastaleeq":"اِلَّا عَجُوْزًا فِی الْغٰبِرِیْنَ ۟ۚ"},{"id":3104,"verse_key":"26:172","text_indopak_nastaleeq":"ثُمَّ دَمَّرْنَا الْاٰخَرِیْنَ ۟ۚ"},{"id":3105,"verse_key":"26:173","text_indopak_nastaleeq":"وَاَمْطَرْنَا عَلَیْهِمْ مَّطَرًا ۚ فَسَآءَ مَطَرُ الْمُنْذَرِیْنَ ۟"},{"id":3106,"verse_key":"26:174","text_indopak_nastaleeq":"اِنَّ فِیْ ذٰلِكَ لَاٰیَةً ؕ وَمَا كَانَ اَكْثَرُهُمْ مُّؤْمِنِیْنَ ۟"},{"id":3107,"verse_key":"26:175","text_indopak_nastaleeq":"وَاِنَّ رَبَّكَ لَهُوَ الْعَزِیْزُ الرَّحِیْمُ ۟۠"},{"id":3108,"verse_key":"26:176","text_indopak_nastaleeq":"كَذَّبَ اَصْحٰبُ لْـَٔیْكَةِ الْمُرْسَلِیْنَ ۟ۚۖ"},{"id":3109,"verse_key":"26:177","text_indopak_nastaleeq":"اِذْ قَالَ لَهُمْ شُعَیْبٌ اَلَا تَتَّقُوْنَ ۟ۚ"},{"id":3110,"verse_key":"26:178","text_indopak_nastaleeq":"اِنِّیْ لَكُمْ رَسُوْلٌ اَمِیْنٌ ۟ۙ"},{"id":3111,"verse_key":"26:179","text_indopak_nastaleeq":"فَاتَّقُوا اللّٰهَ وَاَطِیْعُوْنِ ۟ۚ"},{"id":3112,"verse_key":"26:180","text_indopak_nastaleeq":"وَمَاۤ اَسْـَٔلُكُمْ عَلَیْهِ مِنْ اَجْرٍ ۚ اِنْ اَجْرِیَ اِلَّا عَلٰی رَبِّ الْعٰلَمِیْنَ ۟ؕ"},{"id":3113,"verse_key":"26:181","text_indopak_nastaleeq":"اَوْفُوا الْكَیْلَ وَلَا تَكُوْنُوْا مِنَ الْمُخْسِرِیْنَ ۟ۚ"},{"id":3114,"verse_key":"26:182","text_indopak_nastaleeq":"وَزِنُوْا بِالْقِسْطَاسِ الْمُسْتَقِیْمِ ۟ۚ"},{"id":3115,"verse_key":"26:183","text_indopak_nastaleeq":"وَلَا تَبْخَسُوا النَّاسَ اَشْیَآءَهُمْ وَلَا تَعْثَوْا فِی الْاَرْضِ مُفْسِدِیْنَ ۟ۚ"},{"id":3116,"verse_key":"26:184","text_indopak_nastaleeq":"وَاتَّقُوا الَّذِیْ خَلَقَكُمْ وَالْجِبِلَّةَ الْاَوَّلِیْنَ ۟ؕ"},{"id":3117,"verse_key":"26:185","text_indopak_nastaleeq":"قَالُوْۤا اِنَّمَاۤ اَنْتَ مِنَ الْمُسَحَّرِیْنَ ۟ۙ"},{"id":3118,"verse_key":"26:186","text_indopak_nastaleeq":"وَمَاۤ اَنْتَ اِلَّا بَشَرٌ مِّثْلُنَا وَاِنْ نَّظُنُّكَ لَمِنَ الْكٰذِبِیْنَ ۟ۚ"},{"id":3119,"verse_key":"26:187","text_indopak_nastaleeq":"فَاَسْقِطْ عَلَیْنَا كِسَفًا مِّنَ السَّمَآءِ اِنْ كُنْتَ مِنَ الصّٰدِقِیْنَ ۟ؕ"},{"id":3120,"verse_key":"26:188","text_indopak_nastaleeq":"قَالَ رَبِّیْۤ اَعْلَمُ بِمَا تَعْمَلُوْنَ ۟"},{"id":3121,"verse_key":"26:189","text_indopak_nastaleeq":"فَكَذَّبُوْهُ فَاَخَذَهُمْ عَذَابُ یَوْمِ الظُّلَّةِ ؕ اِنَّهٗ كَانَ عَذَابَ یَوْمٍ عَظِیْمٍ ۟"},{"id":3122,"verse_key":"26:190","text_indopak_nastaleeq":"اِنَّ فِیْ ذٰلِكَ لَاٰیَةً ؕ وَمَا كَانَ اَكْثَرُهُمْ مُّؤْمِنِیْنَ ۟"},{"id":3123,"verse_key":"26:191","text_indopak_nastaleeq":"وَاِنَّ رَبَّكَ لَهُوَ الْعَزِیْزُ الرَّحِیْمُ ۟۠"},{"id":3124,"verse_key":"26:192","text_indopak_nastaleeq":"وَاِنَّهٗ لَتَنْزِیْلُ رَبِّ الْعٰلَمِیْنَ ۟ؕ"},{"id":3125,"verse_key":"26:193","text_indopak_nastaleeq":"نَزَلَ بِهِ الرُّوْحُ الْاَمِیْنُ ۟ۙ"},{"id":3126,"verse_key":"26:194","text_indopak_nastaleeq":"عَلٰی قَلْبِكَ لِتَكُوْنَ مِنَ الْمُنْذِرِیْنَ ۟ۙ"},{"id":3127,"verse_key":"26:195","text_indopak_nastaleeq":"بِلِسَانٍ عَرَبِیٍّ مُّبِیْنٍ ۟ؕ"},{"id":3128,"verse_key":"26:196","text_indopak_nastaleeq":"وَاِنَّهٗ لَفِیْ زُبُرِ الْاَوَّلِیْنَ ۟"},{"id":3129,"verse_key":"26:197","text_indopak_nastaleeq":"اَوَلَمْ یَكُنْ لَّهُمْ اٰیَةً اَنْ یَّعْلَمَهٗ عُلَمٰٓؤُا بَنِیْۤ اِسْرَآءِیْلَ ۟ؕ"},{"id":3130,"verse_key":"26:198","text_indopak_nastaleeq":"وَلَوْ نَزَّلْنٰهُ عَلٰی بَعْضِ الْاَعْجَمِیْنَ ۟ۙ"},{"id":3131,"verse_key":"26:199","text_indopak_nastaleeq":"فَقَرَاَهٗ عَلَیْهِمْ مَّا كَانُوْا بِهٖ مُؤْمِنِیْنَ ۟ؕ"},{"id":3132,"verse_key":"26:200","text_indopak_nastaleeq":"كَذٰلِكَ سَلَكْنٰهُ فِیْ قُلُوْبِ الْمُجْرِمِیْنَ ۟ؕ"},{"id":3133,"verse_key":"26:201","text_indopak_nastaleeq":"لَا یُؤْمِنُوْنَ بِهٖ حَتّٰی یَرَوُا الْعَذَابَ الْاَلِیْمَ ۟ۙ"},{"id":3134,"verse_key":"26:202","text_indopak_nastaleeq":"فَیَاْتِیَهُمْ بَغْتَةً وَّهُمْ لَا یَشْعُرُوْنَ ۟ۙ"},{"id":3135,"verse_key":"26:203","text_indopak_nastaleeq":"فَیَقُوْلُوْا هَلْ نَحْنُ مُنْظَرُوْنَ ۟ؕ"},{"id":3136,"verse_key":"26:204","text_indopak_nastaleeq":"اَفَبِعَذَابِنَا یَسْتَعْجِلُوْنَ ۟"},{"id":3137,"verse_key":"26:205","text_indopak_nastaleeq":"اَفَرَءَیْتَ اِنْ مَّتَّعْنٰهُمْ سِنِیْنَ ۟ۙ"},{"id":3138,"verse_key":"26:206","text_indopak_nastaleeq":"ثُمَّ جَآءَهُمْ مَّا كَانُوْا یُوْعَدُوْنَ ۟ۙ"},{"id":3139,"verse_key":"26:207","text_indopak_nastaleeq":"مَاۤ اَغْنٰی عَنْهُمْ مَّا كَانُوْا یُمَتَّعُوْنَ ۟ؕ"},{"id":3140,"verse_key":"26:208","text_indopak_nastaleeq":"وَمَاۤ اَهْلَكْنَا مِنْ قَرْیَةٍ اِلَّا لَهَا مُنْذِرُوْنَ ۟"},{"id":3141,"verse_key":"26:209","text_indopak_nastaleeq":"ذِكْرٰی ۛ۫ وَمَا كُنَّا ظٰلِمِیْنَ ۟"},{"id":3142,"verse_key":"26:210","text_indopak_nastaleeq":"وَمَا تَنَزَّلَتْ بِهِ الشَّیٰطِیْنُ ۟"},{"id":3143,"verse_key":"26:211","text_indopak_nastaleeq":"وَمَا یَنْۢبَغِیْ لَهُمْ وَمَا یَسْتَطِیْعُوْنَ ۟ؕ"},{"id":3144,"verse_key":"26:212","text_indopak_nastaleeq":"اِنَّهُمْ عَنِ السَّمْعِ لَمَعْزُوْلُوْنَ ۟ؕ"},{"id":3145,"verse_key":"26:213","text_indopak_nastaleeq":"فَلَا تَدْعُ مَعَ اللّٰهِ اِلٰهًا اٰخَرَ فَتَكُوْنَ مِنَ الْمُعَذَّبِیْنَ ۟ۚ"},{"id":3146,"verse_key":"26:214","text_indopak_nastaleeq":"وَاَنْذِرْ عَشِیْرَتَكَ الْاَقْرَبِیْنَ ۟ۙ"},{"id":3147,"verse_key":"26:215","text_indopak_nastaleeq":"وَاخْفِضْ جَنَاحَكَ لِمَنِ اتَّبَعَكَ مِنَ الْمُؤْمِنِیْنَ ۟ۚ"},{"id":3148,"verse_key":"26:216","text_indopak_nastaleeq":"فَاِنْ عَصَوْكَ فَقُلْ اِنِّیْ بَرِیْٓءٌ مِّمَّا تَعْمَلُوْنَ ۟ۚ"},{"id":3149,"verse_key":"26:217","text_indopak_nastaleeq":"وَتَوَكَّلْ عَلَی الْعَزِیْزِ الرَّحِیْمِ ۟ۙ"},{"id":3150,"verse_key":"26:218","text_indopak_nastaleeq":"الَّذِیْ یَرٰىكَ حِیْنَ تَقُوْمُ ۟ۙ"},{"id":3151,"verse_key":"26:219","text_indopak_nastaleeq":"وَتَقَلُّبَكَ فِی السّٰجِدِیْنَ ۟"},{"id":3152,"verse_key":"26:220","text_indopak_nastaleeq":"اِنَّهٗ هُوَ السَّمِیْعُ الْعَلِیْمُ ۟"},{"id":3153,"verse_key":"26:221","text_indopak_nastaleeq":"هَلْ اُنَبِّئُكُمْ عَلٰی مَنْ تَنَزَّلُ الشَّیٰطِیْنُ ۟ؕ"},{"id":3154,"verse_key":"26:222","text_indopak_nastaleeq":"تَنَزَّلُ عَلٰی كُلِّ اَفَّاكٍ اَثِیْمٍ ۟ۙ"},{"id":3155,"verse_key":"26:223","text_indopak_nastaleeq":"یُّلْقُوْنَ السَّمْعَ وَاَكْثَرُهُمْ كٰذِبُوْنَ ۟ؕ"},{"id":3156,"verse_key":"26:224","text_indopak_nastaleeq":"وَالشُّعَرَآءُ یَتَّبِعُهُمُ الْغَاوٗنَ ۟ؕ"},{"id":3157,"verse_key":"26:225","text_indopak_nastaleeq":"اَلَمْ تَرَ اَنَّهُمْ فِیْ كُلِّ وَادٍ یَّهِیْمُوْنَ ۟ۙ"},{"id":3158,"verse_key":"26:226","text_indopak_nastaleeq":"وَاَنَّهُمْ یَقُوْلُوْنَ مَا لَا یَفْعَلُوْنَ ۟ۙ"},{"id":3159,"verse_key":"26:227","text_indopak_nastaleeq":"اِلَّا الَّذِیْنَ اٰمَنُوْا وَعَمِلُوا الصّٰلِحٰتِ وَذَكَرُوا اللّٰهَ كَثِیْرًا وَّانْتَصَرُوْا مِنْ بَعْدِ مَا ظُلِمُوْا ؕ وَسَیَعْلَمُ الَّذِیْنَ ظَلَمُوْۤا اَیَّ مُنْقَلَبٍ یَّنْقَلِبُوْنَ ۟۠"}],"meta":{"filters":{"chapter_number":"26"}}}