{"verses":[{"id":2933,"verse_key":"26:1","text_indopak_nastaleeq":"طٰسٓمّٓ ۟"},{"id":2934,"verse_key":"26:2","text_indopak_nastaleeq":"تِلْكَ اٰیٰتُ الْكِتٰبِ الْمُبِیْنِ ۟"},{"id":2935,"verse_key":"26:3","text_indopak_nastaleeq":"لَعَلَّكَ بَاخِعٌ نَّفْسَكَ اَلَّا یَكُوْنُوْا مُؤْمِنِیْنَ ۟"},{"id":2936,"verse_key":"26:4","text_indopak_nastaleeq":"اِنْ نَّشَاْ نُنَزِّلْ عَلَیْهِمْ مِّنَ السَّمَآءِ اٰیَةً فَظَلَّتْ اَعْنَاقُهُمْ لَهَا خٰضِعِیْنَ ۟"},{"id":2937,"verse_key":"26:5","text_indopak_nastaleeq":"وَمَا یَاْتِیْهِمْ مِّنْ ذِكْرٍ مِّنَ الرَّحْمٰنِ مُحْدَثٍ اِلَّا كَانُوْا عَنْهُ مُعْرِضِیْنَ ۟"},{"id":2938,"verse_key":"26:6","text_indopak_nastaleeq":"فَقَدْ كَذَّبُوْا فَسَیَاْتِیْهِمْ اَنْۢبٰٓؤُا مَا كَانُوْا بِهٖ یَسْتَهْزِءُوْنَ ۟"},{"id":2939,"verse_key":"26:7","text_indopak_nastaleeq":"اَوَلَمْ یَرَوْا اِلَی الْاَرْضِ كَمْ اَنْۢبَتْنَا فِیْهَا مِنْ كُلِّ زَوْجٍ كَرِیْمٍ ۟"},{"id":2940,"verse_key":"26:8","text_indopak_nastaleeq":"اِنَّ فِیْ ذٰلِكَ لَاٰیَةً ؕ وَمَا كَانَ اَكْثَرُهُمْ مُّؤْمِنِیْنَ ۟"},{"id":2941,"verse_key":"26:9","text_indopak_nastaleeq":"وَاِنَّ رَبَّكَ لَهُوَ الْعَزِیْزُ الرَّحِیْمُ ۟۠"},{"id":2942,"verse_key":"26:10","text_indopak_nastaleeq":"وَاِذْ نَادٰی رَبُّكَ مُوْسٰۤی اَنِ ائْتِ الْقَوْمَ الظّٰلِمِیْنَ ۟ۙ"},{"id":2943,"verse_key":"26:11","text_indopak_nastaleeq":"قَوْمَ فِرْعَوْنَ ؕ اَلَا یَتَّقُوْنَ ۟"},{"id":2944,"verse_key":"26:12","text_indopak_nastaleeq":"قَالَ رَبِّ اِنِّیْۤ اَخَافُ اَنْ یُّكَذِّبُوْنِ ۟ؕ"},{"id":2945,"verse_key":"26:13","text_indopak_nastaleeq":"وَیَضِیْقُ صَدْرِیْ وَلَا یَنْطَلِقُ لِسَانِیْ فَاَرْسِلْ اِلٰی هٰرُوْنَ ۟"},{"id":2946,"verse_key":"26:14","text_indopak_nastaleeq":"وَلَهُمْ عَلَیَّ ذَنْۢبٌ فَاَخَافُ اَنْ یَّقْتُلُوْنِ ۟ۚۖ"},{"id":2947,"verse_key":"26:15","text_indopak_nastaleeq":"قَالَ كَلَّا ۚ فَاذْهَبَا بِاٰیٰتِنَاۤ اِنَّا مَعَكُمْ مُّسْتَمِعُوْنَ ۟"},{"id":2948,"verse_key":"26:16","text_indopak_nastaleeq":"فَاْتِیَا فِرْعَوْنَ فَقُوْلَاۤ اِنَّا رَسُوْلُ رَبِّ الْعٰلَمِیْنَ ۟ۙ"},{"id":2949,"verse_key":"26:17","text_indopak_nastaleeq":"اَنْ اَرْسِلْ مَعَنَا بَنِیْۤ اِسْرَآءِیْلَ ۟ؕ"},{"id":2950,"verse_key":"26:18","text_indopak_nastaleeq":"قَالَ اَلَمْ نُرَبِّكَ فِیْنَا وَلِیْدًا وَّلَبِثْتَ فِیْنَا مِنْ عُمُرِكَ سِنِیْنَ ۟ۙ"},{"id":2951,"verse_key":"26:19","text_indopak_nastaleeq":"وَفَعَلْتَ فَعْلَتَكَ الَّتِیْ فَعَلْتَ وَاَنْتَ مِنَ الْكٰفِرِیْنَ ۟"},{"id":2952,"verse_key":"26:20","text_indopak_nastaleeq":"قَالَ فَعَلْتُهَاۤ اِذًا وَّاَنَا مِنَ الضَّآلِّیْنَ ۟ؕ"},{"id":2953,"verse_key":"26:21","text_indopak_nastaleeq":"فَفَرَرْتُ مِنْكُمْ لَمَّا خِفْتُكُمْ فَوَهَبَ لِیْ رَبِّیْ حُكْمًا وَّجَعَلَنِیْ مِنَ الْمُرْسَلِیْنَ ۟"},{"id":2954,"verse_key":"26:22","text_indopak_nastaleeq":"وَتِلْكَ نِعْمَةٌ تَمُنُّهَا عَلَیَّ اَنْ عَبَّدْتَّ بَنِیْۤ اِسْرَآءِیْلَ ۟ؕ"},{"id":2955,"verse_key":"26:23","text_indopak_nastaleeq":"قَالَ فِرْعَوْنُ وَمَا رَبُّ الْعٰلَمِیْنَ ۟ؕ"},{"id":2956,"verse_key":"26:24","text_indopak_nastaleeq":"قَالَ رَبُّ السَّمٰوٰتِ وَالْاَرْضِ وَمَا بَیْنَهُمَا ؕ اِنْ كُنْتُمْ مُّوْقِنِیْنَ ۟"},{"id":2957,"verse_key":"26:25","text_indopak_nastaleeq":"قَالَ لِمَنْ حَوْلَهٗۤ اَلَا تَسْتَمِعُوْنَ ۟"},{"id":2958,"verse_key":"26:26","text_indopak_nastaleeq":"قَالَ رَبُّكُمْ وَرَبُّ اٰبَآىِٕكُمُ الْاَوَّلِیْنَ ۟"},{"id":2959,"verse_key":"26:27","text_indopak_nastaleeq":"قَالَ اِنَّ رَسُوْلَكُمُ الَّذِیْۤ اُرْسِلَ اِلَیْكُمْ لَمَجْنُوْنٌ ۟"},{"id":2960,"verse_key":"26:28","text_indopak_nastaleeq":"قَالَ رَبُّ الْمَشْرِقِ وَالْمَغْرِبِ وَمَا بَیْنَهُمَا ؕ اِنْ كُنْتُمْ تَعْقِلُوْنَ ۟"},{"id":2961,"verse_key":"26:29","text_indopak_nastaleeq":"قَالَ لَىِٕنِ اتَّخَذْتَ اِلٰهًا غَیْرِیْ لَاَجْعَلَنَّكَ مِنَ الْمَسْجُوْنِیْنَ ۟"},{"id":2962,"verse_key":"26:30","text_indopak_nastaleeq":"قَالَ اَوَلَوْ جِئْتُكَ بِشَیْءٍ مُّبِیْنٍ ۟ۚ"},{"id":2963,"verse_key":"26:31","text_indopak_nastaleeq":"قَالَ فَاْتِ بِهٖۤ اِنْ كُنْتَ مِنَ الصّٰدِقِیْنَ ۟"},{"id":2964,"verse_key":"26:32","text_indopak_nastaleeq":"فَاَلْقٰی عَصَاهُ فَاِذَا هِیَ ثُعْبَانٌ مُّبِیْنٌ ۟ۚۖ"},{"id":2965,"verse_key":"26:33","text_indopak_nastaleeq":"وَّنَزَعَ یَدَهٗ فَاِذَا هِیَ بَیْضَآءُ لِلنّٰظِرِیْنَ ۟۠"},{"id":2966,"verse_key":"26:34","text_indopak_nastaleeq":"قَالَ لِلْمَلَاِ حَوْلَهٗۤ اِنَّ هٰذَا لَسٰحِرٌ عَلِیْمٌ ۟ۙ"},{"id":2967,"verse_key":"26:35","text_indopak_nastaleeq":"یُّرِیْدُ اَنْ یُّخْرِجَكُمْ مِّنْ اَرْضِكُمْ بِسِحْرِهٖ ۖۗ فَمَاذَا تَاْمُرُوْنَ ۟"},{"id":2968,"verse_key":"26:36","text_indopak_nastaleeq":"قَالُوْۤا اَرْجِهْ وَاَخَاهُ وَابْعَثْ فِی الْمَدَآىِٕنِ حٰشِرِیْنَ ۟ۙ"},{"id":2969,"verse_key":"26:37","text_indopak_nastaleeq":"یَاْتُوْكَ بِكُلِّ سَحَّارٍ عَلِیْمٍ ۟"},{"id":2970,"verse_key":"26:38","text_indopak_nastaleeq":"فَجُمِعَ السَّحَرَةُ لِمِیْقَاتِ یَوْمٍ مَّعْلُوْمٍ ۟ۙ"},{"id":2971,"verse_key":"26:39","text_indopak_nastaleeq":"وَّقِیْلَ لِلنَّاسِ هَلْ اَنْتُمْ مُّجْتَمِعُوْنَ ۟ۙ"},{"id":2972,"verse_key":"26:40","text_indopak_nastaleeq":"لَعَلَّنَا نَتَّبِعُ السَّحَرَةَ اِنْ كَانُوْا هُمُ الْغٰلِبِیْنَ ۟"},{"id":2973,"verse_key":"26:41","text_indopak_nastaleeq":"فَلَمَّا جَآءَ السَّحَرَةُ قَالُوْا لِفِرْعَوْنَ اَىِٕنَّ لَنَا لَاَجْرًا اِنْ كُنَّا نَحْنُ الْغٰلِبِیْنَ ۟"},{"id":2974,"verse_key":"26:42","text_indopak_nastaleeq":"قَالَ نَعَمْ وَاِنَّكُمْ اِذًا لَّمِنَ الْمُقَرَّبِیْنَ ۟"},{"id":2975,"verse_key":"26:43","text_indopak_nastaleeq":"قَالَ لَهُمْ مُّوْسٰۤی اَلْقُوْا مَاۤ اَنْتُمْ مُّلْقُوْنَ ۟"},{"id":2976,"verse_key":"26:44","text_indopak_nastaleeq":"فَاَلْقَوْا حِبَالَهُمْ وَعِصِیَّهُمْ وَقَالُوْا بِعِزَّةِ فِرْعَوْنَ اِنَّا لَنَحْنُ الْغٰلِبُوْنَ ۟"},{"id":2977,"verse_key":"26:45","text_indopak_nastaleeq":"فَاَلْقٰی مُوْسٰی عَصَاهُ فَاِذَا هِیَ تَلْقَفُ مَا یَاْفِكُوْنَ ۟ۚۖ"},{"id":2978,"verse_key":"26:46","text_indopak_nastaleeq":"فَاُلْقِیَ السَّحَرَةُ سٰجِدِیْنَ ۟ۙ"},{"id":2979,"verse_key":"26:47","text_indopak_nastaleeq":"قَالُوْۤا اٰمَنَّا بِرَبِّ الْعٰلَمِیْنَ ۟ۙ"},{"id":2980,"verse_key":"26:48","text_indopak_nastaleeq":"رَبِّ مُوْسٰی وَهٰرُوْنَ ۟"},{"id":2981,"verse_key":"26:49","text_indopak_nastaleeq":"قَالَ اٰمَنْتُمْ لَهٗ قَبْلَ اَنْ اٰذَنَ لَكُمْ ۚ اِنَّهٗ لَكَبِیْرُكُمُ الَّذِیْ عَلَّمَكُمُ السِّحْرَ ۚ فَلَسَوْفَ تَعْلَمُوْنَ ؕ۬ لَاُقَطِّعَنَّ اَیْدِیَكُمْ وَاَرْجُلَكُمْ مِّنْ خِلَافٍ وَّلَاُوصَلِّبَنَّكُمْ اَجْمَعِیْنَ ۟ۚ"},{"id":2982,"verse_key":"26:50","text_indopak_nastaleeq":"قَالُوْا لَا ضَیْرَ ؗ اِنَّاۤ اِلٰی رَبِّنَا مُنْقَلِبُوْنَ ۟ۚ"},{"id":2983,"verse_key":"26:51","text_indopak_nastaleeq":"اِنَّا نَطْمَعُ اَنْ یَّغْفِرَ لَنَا رَبُّنَا خَطٰیٰنَاۤ اَنْ كُنَّاۤ اَوَّلَ الْمُؤْمِنِیْنَ ۟ؕ۠"},{"id":2984,"verse_key":"26:52","text_indopak_nastaleeq":"وَاَوْحَیْنَاۤ اِلٰی مُوْسٰۤی اَنْ اَسْرِ بِعِبَادِیْۤ اِنَّكُمْ مُّتَّبَعُوْنَ ۟"},{"id":2985,"verse_key":"26:53","text_indopak_nastaleeq":"فَاَرْسَلَ فِرْعَوْنُ فِی الْمَدَآىِٕنِ حٰشِرِیْنَ ۟ۚ"},{"id":2986,"verse_key":"26:54","text_indopak_nastaleeq":"اِنَّ هٰۤؤُلَآءِ لَشِرْذِمَةٌ قَلِیْلُوْنَ ۟ۙ"},{"id":2987,"verse_key":"26:55","text_indopak_nastaleeq":"وَاِنَّهُمْ لَنَا لَغَآىِٕظُوْنَ ۟ۙ"},{"id":2988,"verse_key":"26:56","text_indopak_nastaleeq":"وَاِنَّا لَجَمِیْعٌ حٰذِرُوْنَ ۟ؕ"},{"id":2989,"verse_key":"26:57","text_indopak_nastaleeq":"فَاَخْرَجْنٰهُمْ مِّنْ جَنّٰتٍ وَّعُیُوْنٍ ۟ۙ"},{"id":2990,"verse_key":"26:58","text_indopak_nastaleeq":"وَّكُنُوْزٍ وَّمَقَامٍ كَرِیْمٍ ۟ۙ"},{"id":2991,"verse_key":"26:59","text_indopak_nastaleeq":"كَذٰلِكَ ؕ وَاَوْرَثْنٰهَا بَنِیْۤ اِسْرَآءِیْلَ ۟ؕ"},{"id":2992,"verse_key":"26:60","text_indopak_nastaleeq":"فَاَتْبَعُوْهُمْ مُّشْرِقِیْنَ ۟"},{"id":2993,"verse_key":"26:61","text_indopak_nastaleeq":"فَلَمَّا تَرَآءَ الْجَمْعٰنِ قَالَ اَصْحٰبُ مُوْسٰۤی اِنَّا لَمُدْرَكُوْنَ ۟ۚ"},{"id":2994,"verse_key":"26:62","text_indopak_nastaleeq":"قَالَ كَلَّا ۚ اِنَّ مَعِیَ رَبِّیْ سَیَهْدِیْنِ ۟"},{"id":2995,"verse_key":"26:63","text_indopak_nastaleeq":"فَاَوْحَیْنَاۤ اِلٰی مُوْسٰۤی اَنِ اضْرِبْ بِّعَصَاكَ الْبَحْرَ ؕ فَانْفَلَقَ فَكَانَ كُلُّ فِرْقٍ كَالطَّوْدِ الْعَظِیْمِ ۟ۚ"},{"id":2996,"verse_key":"26:64","text_indopak_nastaleeq":"وَاَزْلَفْنَا ثَمَّ الْاٰخَرِیْنَ ۟ۚ"},{"id":2997,"verse_key":"26:65","text_indopak_nastaleeq":"وَاَنْجَیْنَا مُوْسٰی وَمَنْ مَّعَهٗۤ اَجْمَعِیْنَ ۟ۚ"},{"id":2998,"verse_key":"26:66","text_indopak_nastaleeq":"ثُمَّ اَغْرَقْنَا الْاٰخَرِیْنَ ۟ؕ"},{"id":2999,"verse_key":"26:67","text_indopak_nastaleeq":"اِنَّ فِیْ ذٰلِكَ لَاٰیَةً ؕ وَمَا كَانَ اَكْثَرُهُمْ مُّؤْمِنِیْنَ ۟"},{"id":3000,"verse_key":"26:68","text_indopak_nastaleeq":"وَاِنَّ رَبَّكَ لَهُوَ الْعَزِیْزُ الرَّحِیْمُ ۟۠"},{"id":3001,"verse_key":"26:69","text_indopak_nastaleeq":"وَاتْلُ عَلَیْهِمْ نَبَاَ اِبْرٰهِیْمَ ۟ۘ"},{"id":3002,"verse_key":"26:70","text_indopak_nastaleeq":"اِذْ قَالَ لِاَبِیْهِ وَقَوْمِهٖ مَا تَعْبُدُوْنَ ۟"},{"id":3003,"verse_key":"26:71","text_indopak_nastaleeq":"قَالُوْا نَعْبُدُ اَصْنَامًا فَنَظَلُّ لَهَا عٰكِفِیْنَ ۟"},{"id":3004,"verse_key":"26:72","text_indopak_nastaleeq":"قَالَ هَلْ یَسْمَعُوْنَكُمْ اِذْ تَدْعُوْنَ ۟ۙ"},{"id":3005,"verse_key":"26:73","text_indopak_nastaleeq":"اَوْ یَنْفَعُوْنَكُمْ اَوْ یَضُرُّوْنَ ۟"},{"id":3006,"verse_key":"26:74","text_indopak_nastaleeq":"قَالُوْا بَلْ وَجَدْنَاۤ اٰبَآءَنَا كَذٰلِكَ یَفْعَلُوْنَ ۟"},{"id":3007,"verse_key":"26:75","text_indopak_nastaleeq":"قَالَ اَفَرَءَیْتُمْ مَّا كُنْتُمْ تَعْبُدُوْنَ ۟ۙ"},{"id":3008,"verse_key":"26:76","text_indopak_nastaleeq":"اَنْتُمْ وَاٰبَآؤُكُمُ الْاَقْدَمُوْنَ ۟ؗۖ"},{"id":3009,"verse_key":"26:77","text_indopak_nastaleeq":"فَاِنَّهُمْ عَدُوٌّ لِّیْۤ اِلَّا رَبَّ الْعٰلَمِیْنَ ۟ۙ"},{"id":3010,"verse_key":"26:78","text_indopak_nastaleeq":"الَّذِیْ خَلَقَنِیْ فَهُوَ یَهْدِیْنِ ۟ۙ"},{"id":3011,"verse_key":"26:79","text_indopak_nastaleeq":"وَالَّذِیْ هُوَ یُطْعِمُنِیْ وَیَسْقِیْنِ ۟ۙ"},{"id":3012,"verse_key":"26:80","text_indopak_nastaleeq":"وَاِذَا مَرِضْتُ فَهُوَ یَشْفِیْنِ ۟"},{"id":3013,"verse_key":"26:81","text_indopak_nastaleeq":"وَالَّذِیْ یُمِیْتُنِیْ ثُمَّ یُحْیِیْنِ ۟ۙ"},{"id":3014,"verse_key":"26:82","text_indopak_nastaleeq":"وَالَّذِیْۤ اَطْمَعُ اَنْ یَّغْفِرَ لِیْ خَطِیْٓـَٔتِیْ یَوْمَ الدِّیْنِ ۟ؕ"},{"id":3015,"verse_key":"26:83","text_indopak_nastaleeq":"رَبِّ هَبْ لِیْ حُكْمًا وَّاَلْحِقْنِیْ بِالصّٰلِحِیْنَ ۟ۙ"},{"id":3016,"verse_key":"26:84","text_indopak_nastaleeq":"وَاجْعَلْ لِّیْ لِسَانَ صِدْقٍ فِی الْاٰخِرِیْنَ ۟ۙ"},{"id":3017,"verse_key":"26:85","text_indopak_nastaleeq":"وَاجْعَلْنِیْ مِنْ وَّرَثَةِ جَنَّةِ النَّعِیْمِ ۟ۙ"},{"id":3018,"verse_key":"26:86","text_indopak_nastaleeq":"وَاغْفِرْ لِاَبِیْۤ اِنَّهٗ كَانَ مِنَ الضَّآلِّیْنَ ۟ۙ"},{"id":3019,"verse_key":"26:87","text_indopak_nastaleeq":"وَلَا تُخْزِنِیْ یَوْمَ یُبْعَثُوْنَ ۟ۙ"},{"id":3020,"verse_key":"26:88","text_indopak_nastaleeq":"یَوْمَ لَا یَنْفَعُ مَالٌ وَّلَا بَنُوْنَ ۟ۙ"},{"id":3021,"verse_key":"26:89","text_indopak_nastaleeq":"اِلَّا مَنْ اَتَی اللّٰهَ بِقَلْبٍ سَلِیْمٍ ۟ؕ"},{"id":3022,"verse_key":"26:90","text_indopak_nastaleeq":"وَاُزْلِفَتِ الْجَنَّةُ لِلْمُتَّقِیْنَ ۟ۙ"},{"id":3023,"verse_key":"26:91","text_indopak_nastaleeq":"وَبُرِّزَتِ الْجَحِیْمُ لِلْغٰوِیْنَ ۟ۙ"},{"id":3024,"verse_key":"26:92","text_indopak_nastaleeq":"وَقِیْلَ لَهُمْ اَیْنَ مَا كُنْتُمْ تَعْبُدُوْنَ ۟ۙ"},{"id":3025,"verse_key":"26:93","text_indopak_nastaleeq":"مِنْ دُوْنِ اللّٰهِ ؕ هَلْ یَنْصُرُوْنَكُمْ اَوْ یَنْتَصِرُوْنَ ۟ؕ"},{"id":3026,"verse_key":"26:94","text_indopak_nastaleeq":"فَكُبْكِبُوْا فِیْهَا هُمْ وَالْغَاوٗنَ ۟ۙ"},{"id":3027,"verse_key":"26:95","text_indopak_nastaleeq":"وَجُنُوْدُ اِبْلِیْسَ اَجْمَعُوْنَ ۟ؕ"},{"id":3028,"verse_key":"26:96","text_indopak_nastaleeq":"قَالُوْا وَهُمْ فِیْهَا یَخْتَصِمُوْنَ ۟ۙ"},{"id":3029,"verse_key":"26:97","text_indopak_nastaleeq":"تَاللّٰهِ اِنْ كُنَّا لَفِیْ ضَلٰلٍ مُّبِیْنٍ ۟ۙ"},{"id":3030,"verse_key":"26:98","text_indopak_nastaleeq":"اِذْ نُسَوِّیْكُمْ بِرَبِّ الْعٰلَمِیْنَ ۟"},{"id":3031,"verse_key":"26:99","text_indopak_nastaleeq":"وَمَاۤ اَضَلَّنَاۤ اِلَّا الْمُجْرِمُوْنَ ۟"},{"id":3032,"verse_key":"26:100","text_indopak_nastaleeq":"فَمَا لَنَا مِنْ شَافِعِیْنَ ۟ۙ"},{"id":3033,"verse_key":"26:101","text_indopak_nastaleeq":"وَلَا صَدِیْقٍ حَمِیْمٍ ۟"},{"id":3034,"verse_key":"26:102","text_indopak_nastaleeq":"فَلَوْ اَنَّ لَنَا كَرَّةً فَنَكُوْنَ مِنَ الْمُؤْمِنِیْنَ ۟"},{"id":3035,"verse_key":"26:103","text_indopak_nastaleeq":"اِنَّ فِیْ ذٰلِكَ لَاٰیَةً ؕ وَمَا كَانَ اَكْثَرُهُمْ مُّؤْمِنِیْنَ ۟"},{"id":3036,"verse_key":"26:104","text_indopak_nastaleeq":"وَاِنَّ رَبَّكَ لَهُوَ الْعَزِیْزُ الرَّحِیْمُ ۟۠"},{"id":3037,"verse_key":"26:105","text_indopak_nastaleeq":"كَذَّبَتْ قَوْمُ نُوْحِ لْمُرْسَلِیْنَ ۟ۚۖ"},{"id":3038,"verse_key":"26:106","text_indopak_nastaleeq":"اِذْ قَالَ لَهُمْ اَخُوْهُمْ نُوْحٌ اَلَا تَتَّقُوْنَ ۟ۚ"},{"id":3039,"verse_key":"26:107","text_indopak_nastaleeq":"اِنِّیْ لَكُمْ رَسُوْلٌ اَمِیْنٌ ۟ۙ"},{"id":3040,"verse_key":"26:108","text_indopak_nastaleeq":"فَاتَّقُوا اللّٰهَ وَاَطِیْعُوْنِ ۟ۚ"},{"id":3041,"verse_key":"26:109","text_indopak_nastaleeq":"وَمَاۤ اَسْـَٔلُكُمْ عَلَیْهِ مِنْ اَجْرٍ ۚ اِنْ اَجْرِیَ اِلَّا عَلٰی رَبِّ الْعٰلَمِیْنَ ۟ۚ"},{"id":3042,"verse_key":"26:110","text_indopak_nastaleeq":"فَاتَّقُوا اللّٰهَ وَاَطِیْعُوْنِ ۟ؕ"},{"id":3043,"verse_key":"26:111","text_indopak_nastaleeq":"قَالُوْۤا اَنُؤْمِنُ لَكَ وَاتَّبَعَكَ الْاَرْذَلُوْنَ ۟ؕ"},{"id":3044,"verse_key":"26:112","text_indopak_nastaleeq":"قَالَ وَمَا عِلْمِیْ بِمَا كَانُوْا یَعْمَلُوْنَ ۟ۚ"},{"id":3045,"verse_key":"26:113","text_indopak_nastaleeq":"اِنْ حِسَابُهُمْ اِلَّا عَلٰی رَبِّیْ لَوْ تَشْعُرُوْنَ ۟ۚ"},{"id":3046,"verse_key":"26:114","text_indopak_nastaleeq":"وَمَاۤ اَنَا بِطَارِدِ الْمُؤْمِنِیْنَ ۟ۚ"},{"id":3047,"verse_key":"26:115","text_indopak_nastaleeq":"اِنْ اَنَا اِلَّا نَذِیْرٌ مُّبِیْنٌ ۟ؕ"},{"id":3048,"verse_key":"26:116","text_indopak_nastaleeq":"قَالُوْا لَىِٕنْ لَّمْ تَنْتَهِ یٰنُوْحُ لَتَكُوْنَنَّ مِنَ الْمَرْجُوْمِیْنَ ۟ؕ"},{"id":3049,"verse_key":"26:117","text_indopak_nastaleeq":"قَالَ رَبِّ اِنَّ قَوْمِیْ كَذَّبُوْنِ ۟ۚۖ"},{"id":3050,"verse_key":"26:118","text_indopak_nastaleeq":"فَافْتَحْ بَیْنِیْ وَبَیْنَهُمْ فَتْحًا وَّنَجِّنِیْ وَمَنْ مَّعِیَ مِنَ الْمُؤْمِنِیْنَ ۟"},{"id":3051,"verse_key":"26:119","text_indopak_nastaleeq":"فَاَنْجَیْنٰهُ وَمَنْ مَّعَهٗ فِی الْفُلْكِ الْمَشْحُوْنِ ۟ۚ"},{"id":3052,"verse_key":"26:120","text_indopak_nastaleeq":"ثُمَّ اَغْرَقْنَا بَعْدُ الْبٰقِیْنَ ۟ؕ"},{"id":3053,"verse_key":"26:121","text_indopak_nastaleeq":"اِنَّ فِیْ ذٰلِكَ لَاٰیَةً ؕ وَمَا كَانَ اَكْثَرُهُمْ مُّؤْمِنِیْنَ ۟"},{"id":3054,"verse_key":"26:122","text_indopak_nastaleeq":"وَاِنَّ رَبَّكَ لَهُوَ الْعَزِیْزُ الرَّحِیْمُ ۟۠"},{"id":3055,"verse_key":"26:123","text_indopak_nastaleeq":"كَذَّبَتْ عَادُ لْمُرْسَلِیْنَ ۟ۚۖ"},{"id":3056,"verse_key":"26:124","text_indopak_nastaleeq":"اِذْ قَالَ لَهُمْ اَخُوْهُمْ هُوْدٌ اَلَا تَتَّقُوْنَ ۟ۚ"},{"id":3057,"verse_key":"26:125","text_indopak_nastaleeq":"اِنِّیْ لَكُمْ رَسُوْلٌ اَمِیْنٌ ۟ۙ"},{"id":3058,"verse_key":"26:126","text_indopak_nastaleeq":"فَاتَّقُوا اللّٰهَ وَاَطِیْعُوْنِ ۟ۚ"},{"id":3059,"verse_key":"26:127","text_indopak_nastaleeq":"وَمَاۤ اَسْـَٔلُكُمْ عَلَیْهِ مِنْ اَجْرٍ ۚ اِنْ اَجْرِیَ اِلَّا عَلٰی رَبِّ الْعٰلَمِیْنَ ۟ؕ"},{"id":3060,"verse_key":"26:128","text_indopak_nastaleeq":"اَتَبْنُوْنَ بِكُلِّ رِیْعٍ اٰیَةً تَعْبَثُوْنَ ۟ۙ"},{"id":3061,"verse_key":"26:129","text_indopak_nastaleeq":"وَتَتَّخِذُوْنَ مَصَانِعَ لَعَلَّكُمْ تَخْلُدُوْنَ ۟ۚ"},{"id":3062,"verse_key":"26:130","text_indopak_nastaleeq":"وَاِذَا بَطَشْتُمْ بَطَشْتُمْ جَبَّارِیْنَ ۟ۚ"},{"id":3063,"verse_key":"26:131","text_indopak_nastaleeq":"فَاتَّقُوا اللّٰهَ وَاَطِیْعُوْنِ ۟ۚ"},{"id":3064,"verse_key":"26:132","text_indopak_nastaleeq":"وَاتَّقُوا الَّذِیْۤ اَمَدَّكُمْ بِمَا تَعْلَمُوْنَ ۟ۚ"},{"id":3065,"verse_key":"26:133","text_indopak_nastaleeq":"اَمَدَّكُمْ بِاَنْعَامٍ وَّبَنِیْنَ ۟ۚۙ"},{"id":3066,"verse_key":"26:134","text_indopak_nastaleeq":"وَجَنّٰتٍ وَّعُیُوْنٍ ۟ۚ"},{"id":3067,"verse_key":"26:135","text_indopak_nastaleeq":"اِنِّیْۤ اَخَافُ عَلَیْكُمْ عَذَابَ یَوْمٍ عَظِیْمٍ ۟ؕ"},{"id":3068,"verse_key":"26:136","text_indopak_nastaleeq":"قَالُوْا سَوَا