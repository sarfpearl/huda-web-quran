{"verses":[{"id":5885,"verse_key":"84:1","text_indopak_nastaleeq":"اِذَا السَّمَآءُ انْشَقَّتْ ۟ۙ"},{"id":5886,"verse_key":"84:2","text_indopak_nastaleeq":"وَاَذِنَتْ لِرَبِّهَا وَحُقَّتْ ۟ۙ"},{"id":5887,"verse_key":"84:3","text_indopak_nastaleeq":"وَاِذَا الْاَرْضُ مُدَّتْ ۟ؕ"},{"id":5888,"verse_key":"84:4","text_indopak_nastaleeq":"وَاَلْقَتْ مَا فِیْهَا وَتَخَلَّتْ ۟ۙ"},{"id":5889,"verse_key":"84:5","text_indopak_nastaleeq":"وَاَذِنَتْ لِرَبِّهَا وَحُقَّتْ ۟ؕ"},{"id":5890,"verse_key":"84:6","text_indopak_nastaleeq":"یٰۤاَیُّهَا الْاِنْسَانُ اِنَّكَ كَادِحٌ اِلٰی رَبِّكَ كَدْحًا فَمُلٰقِیْهِ ۟ۚ"},{"id":5891,"verse_key":"84:7","text_indopak_nastaleeq":"فَاَمَّا مَنْ اُوْتِیَ كِتٰبَهٗ بِیَمِیْنِهٖ ۟ۙ"},{"id":5892,"verse_key":"84:8","text_indopak_nastaleeq":"فَسَوْفَ یُحَاسَبُ حِسَابًا یَّسِیْرًا ۟ۙ"},{"id":5893,"verse_key":"84:9","text_indopak_nastaleeq":"وَّیَنْقَلِبُ اِلٰۤی اَهْلِهٖ مَسْرُوْرًا ۟ؕ"},{"id":5894,"verse_key":"84:10","text_indopak_nastaleeq":"وَاَمَّا مَنْ اُوْتِیَ كِتٰبَهٗ وَرَآءَ ظَهْرِهٖ ۟ۙ"},{"id":5895,"verse_key":"84:11","text_indopak_nastaleeq":"فَسَوْفَ یَدْعُوْا ثُبُوْرًا ۟ۙ"},{"id":5896,"verse_key":"84:12","text_indopak_nastaleeq":"وَّیَصْلٰی سَعِیْرًا ۟ؕ"},{"id":5897,"verse_key":"84:13","text_indopak_nastaleeq":"اِنَّهٗ كَانَ فِیْۤ اَهْلِهٖ مَسْرُوْرًا ۟ؕ"},{"id":5898,"verse_key":"84:14","text_indopak_nastaleeq":"اِنَّهٗ ظَنَّ اَنْ لَّنْ یَّحُوْرَ ۟ۚۛ"},{"id":5899,"verse_key":"84:15","text_indopak_nastaleeq":"بَلٰۤی ۛۚ اِنَّ رَبَّهٗ كَانَ بِهٖ بَصِیْرًا ۟ؕ"},{"id":5900,"verse_key":"84:16","text_indopak_nastaleeq":"فَلَاۤ اُقْسِمُ بِالشَّفَقِ ۟ۙ"},{"id":5901,"verse_key":"84:17","text_indopak_nastaleeq":"وَالَّیْلِ وَمَا وَسَقَ ۟ۙ"},{"id":5902,"verse_key":"84:18","text_indopak_nastaleeq":"وَالْقَمَرِ اِذَا اتَّسَقَ ۟ۙ"},{"id":5903,"verse_key":"84:19","text_indopak_nastaleeq":"لَتَرْكَبُنَّ طَبَقًا عَنْ طَبَقٍ ۟ؕ"},{"id":5904,"verse_key":"84:20","text_indopak_nastaleeq":"فَمَا لَهُمْ لَا یُؤْمِنُوْنَ ۟ۙ"},{"id":5905,"verse_key":"84:21","text_indopak_nastaleeq":"وَاِذَا قُرِئَ عَلَیْهِمُ الْقُرْاٰنُ لَا یَسْجُدُوْنَ ۟"},{"id":5906,"verse_key":"84:22","text_indopak_nastaleeq":"بَلِ الَّذِیْنَ كَفَرُوْا یُكَذِّبُوْنَ ۟ؗۖ"},{"id":5907,"verse_key":"84:23","text_indopak_nastaleeq":"وَاللّٰهُ اَعْلَمُ بِمَا یُوْعُوْنَ ۟ؗۖ"},{"id":5908,"verse_key":"84:24","text_indopak_nastaleeq":"فَبَشِّرْهُمْ بِعَذَابٍ اَلِیْمٍ ۟ۙ"},{"id":5909,"verse_key":"84:25","text_indopak_nastaleeq":"اِلَّا الَّذِیْنَ اٰمَنُوْا وَعَمِلُوا الصّٰلِحٰتِ لَهُمْ اَجْرٌ غَیْرُ مَمْنُوْنٍ ۟۠"}],"meta":{"filters":{"chapter_number":"84"}}}