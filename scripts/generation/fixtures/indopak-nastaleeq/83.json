{"verses":[{"id":5849,"verse_key":"83:1","text_indopak_nastaleeq":"وَیْلٌ لِّلْمُطَفِّفِیْنَ ۟ۙ"},{"id":5850,"verse_key":"83:2","text_indopak_nastaleeq":"الَّذِیْنَ اِذَا اكْتَالُوْا عَلَی النَّاسِ یَسْتَوْفُوْنَ ۟ؗۖ"},{"id":5851,"verse_key":"83:3","text_indopak_nastaleeq":"وَاِذَا كَالُوْهُمْ اَوْ وَّزَنُوْهُمْ یُخْسِرُوْنَ ۟ؕ"},{"id":5852,"verse_key":"83:4","text_indopak_nastaleeq":"اَلَا یَظُنُّ اُولٰٓىِٕكَ اَنَّهُمْ مَّبْعُوْثُوْنَ ۟ۙ"},{"id":5853,"verse_key":"83:5","text_indopak_nastaleeq":"لِیَوْمٍ عَظِیْمٍ ۟ۙ"},{"id":5854,"verse_key":"83:6","text_indopak_nastaleeq":"یَّوْمَ یَقُوْمُ النَّاسُ لِرَبِّ الْعٰلَمِیْنَ ۟ؕ"},{"id":5855,"verse_key":"83:7","text_indopak_nastaleeq":"كَلَّاۤ اِنَّ كِتٰبَ الْفُجَّارِ لَفِیْ سِجِّیْنٍ ۟ؕ"},{"id":5856,"verse_key":"83:8","text_indopak_nastaleeq":"وَمَاۤ اَدْرٰىكَ مَا سِجِّیْنٌ ۟ؕ"},{"id":5857,"verse_key":"83:9","text_indopak_nastaleeq":"كِتٰبٌ مَّرْقُوْمٌ ۟ؕ"},{"id":5858,"verse_key":"83:10","text_indopak_nastaleeq":"وَیْلٌ یَّوْمَىِٕذٍ لِّلْمُكَذِّبِیْنَ ۟ۙ"},{"id":5859,"verse_key":"83:11","text_indopak_nastaleeq":"الَّذِیْنَ یُكَذِّبُوْنَ بِیَوْمِ الدِّیْنِ ۟ؕ"},{"id":5860,"verse_key":"83:12","text_indopak_nastaleeq":"وَمَا یُكَذِّبُ بِهٖۤ اِلَّا كُلُّ مُعْتَدٍ اَثِیْمٍ ۟ۙ"},{"id":5861,"verse_key":"83:13","text_indopak_nastaleeq":"اِذَا تُتْلٰی عَلَیْهِ اٰیٰتُنَا قَالَ اَسَاطِیْرُ الْاَوَّلِیْنَ ۟ؕ"},{"id":5862,"verse_key":"83:14","text_indopak_nastaleeq":"كَلَّا بَلْ ٚ رَانَ عَلٰی قُلُوْبِهِمْ مَّا كَانُوْا یَكْسِبُوْنَ ۟"},{"id":5863,"verse_key":"83:15","text_indopak_nastaleeq":"كَلَّاۤ اِنَّهُمْ عَنْ رَّبِّهِمْ یَوْمَىِٕذٍ لَّمَحْجُوْبُوْنَ ۟ؕ"},{"id":5864,"verse_key":"83:16","text_indopak_nastaleeq":"ثُمَّ اِنَّهُمْ لَصَالُوا الْجَحِیْمِ ۟ؕ"},{"id":5865,"verse_key":"83:17","text_indopak_nastaleeq":"ثُمَّ یُقَالُ هٰذَا الَّذِیْ كُنْتُمْ بِهٖ تُكَذِّبُوْنَ ۟ؕ"},{"id":5866,"verse_key":"83:18","text_indopak_nastaleeq":"كَلَّاۤ اِنَّ كِتٰبَ الْاَبْرَارِ لَفِیْ عِلِّیِّیْنَ ۟ؕ"},{"id":5867,"verse_key":"83:19","text_indopak_nastaleeq":"وَمَاۤ اَدْرٰىكَ مَا عِلِّیُّوْنَ ۟ؕ"},{"id":5868,"verse_key":"83:20","text_indopak_nastaleeq":"كِتٰبٌ مَّرْقُوْمٌ ۟ۙ"},{"id":5869,"verse_key":"83:21","text_indopak_nastaleeq":"یَّشْهَدُهُ الْمُقَرَّبُوْنَ ۟ؕ"},{"id":5870,"verse_key":"83:22","text_indopak_nastaleeq":"اِنَّ الْاَبْرَارَ لَفِیْ نَعِیْمٍ ۟ۙ"},{"id":5871,"verse_key":"83:23","text_indopak_nastaleeq":"عَلَی الْاَرَآىِٕكِ یَنْظُرُوْنَ ۟ۙ"},{"id":5872,"verse_key":"83:24","text_indopak_nastaleeq":"تَعْرِفُ فِیْ وُجُوْهِهِمْ نَضْرَةَ النَّعِیْمِ ۟ۚ"},{"id":5873,"verse_key":"83:25","text_indopak_nastaleeq":"یُسْقَوْنَ مِنْ رَّحِیْقٍ مَّخْتُوْمٍ ۟ۙ"},{"id":5874,"verse_key":"83:26","text_indopak_nastaleeq":"خِتٰمُهٗ مِسْكٌ ؕ وَفِیْ ذٰلِكَ فَلْیَتَنَافَسِ الْمُتَنَافِسُوْنَ ۟ؕ"},{"id":5875,"verse_key":"83:27","text_indopak_nastaleeq":"وَمِزَاجُهٗ مِنْ تَسْنِیْمٍ ۟ۙ"},{"id":5876,"verse_key":"83:28","text_indopak_nastaleeq":"عَیْنًا یَّشْرَبُ بِهَا الْمُقَرَّبُوْنَ ۟ؕ"},{"id":5877,"verse_key":"83:29","text_indopak_nastaleeq":"اِنَّ الَّذِیْنَ اَجْرَمُوْا كَانُوْا مِنَ الَّذِیْنَ اٰمَنُوْا یَضْحَكُوْنَ ۟ؗۖ"},{"id":5878,"verse_key":"83:30","text_indopak_nastaleeq":"وَاِذَا مَرُّوْا بِهِمْ یَتَغَامَزُوْنَ ۟ؗۖ"},{"id":5879,"verse_key":"83:31","text_indopak_nastaleeq":"وَاِذَا انْقَلَبُوْۤا اِلٰۤی اَهْلِهِمُ انْقَلَبُوْا فَكِهِیْنَ ۟ؗۖ"},{"id":5880,"verse_key":"83:32","text_indopak_nastaleeq":"وَاِذَا رَاَوْهُمْ قَالُوْۤا اِنَّ هٰۤؤُلَآءِ لَضَآلُّوْنَ ۟ۙ"},{"id":5881,"verse_key":"83:33","text_indopak_nastaleeq":"وَمَاۤ اُرْسِلُوْا عَلَیْهِمْ حٰفِظِیْنَ ۟ؕ"},{"id":5882,"verse_key":"83:34","text_indopak_nastaleeq":"فَالْیَوْمَ الَّذِیْنَ اٰمَنُوْا مِنَ الْكُفَّارِ یَضْحَكُوْنَ ۟ۙ"},{"id":5883,"verse_key":"83:35","text_indopak_nastaleeq":"عَلَی الْاَرَآىِٕكِ ۙ یَنْظُرُوْنَ ۟ؕ"},{"id":5884,"verse_key":"83:36","text_indopak_nastaleeq":"هَلْ ثُوِّبَ الْكُفَّارُ مَا كَانُوْا یَفْعَلُوْنَ ۟۠"}],"meta":{"filters":{"chapter_number":"83"}}}