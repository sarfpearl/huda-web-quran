{"verses":[{"id":5552,"verse_key":"75:1","text_indopak_nastaleeq":"لَاۤ اُقْسِمُ بِیَوْمِ الْقِیٰمَةِ ۟ۙ"},{"id":5553,"verse_key":"75:2","text_indopak_nastaleeq":"وَلَاۤ اُقْسِمُ بِالنَّفْسِ اللَّوَّامَةِ ۟ؕ"},{"id":5554,"verse_key":"75:3","text_indopak_nastaleeq":"اَیَحْسَبُ الْاِنْسَانُ اَلَّنْ نَّجْمَعَ عِظَامَهٗ ۟ؕ"},{"id":5555,"verse_key":"75:4","text_indopak_nastaleeq":"بَلٰى قٰدِرِیْنَ عَلٰۤی اَنْ نُّسَوِّیَ بَنَانَهٗ ۟"},{"id":5556,"verse_key":"75:5","text_indopak_nastaleeq":"بَلْ یُرِیْدُ الْاِنْسَانُ لِیَفْجُرَ اَمَامَهٗ ۟ۚ"},{"id":5557,"verse_key":"75:6","text_indopak_nastaleeq":"یَسْـَٔلُ اَیَّانَ یَوْمُ الْقِیٰمَةِ ۟ؕ"},{"id":5558,"verse_key":"75:7","text_indopak_nastaleeq":"فَاِذَا بَرِقَ الْبَصَرُ ۟ۙ"},{"id":5559,"verse_key":"75:8","text_indopak_nastaleeq":"وَخَسَفَ الْقَمَرُ ۟ۙ"},{"id":5560,"verse_key":"75:9","text_indopak_nastaleeq":"وَجُمِعَ الشَّمْسُ وَالْقَمَرُ ۟ۙ"},{"id":5561,"verse_key":"75:10","text_indopak_nastaleeq":"یَقُوْلُ الْاِنْسَانُ یَوْمَىِٕذٍ اَیْنَ الْمَفَرُّ ۟ۚ"},{"id":5562,"verse_key":"75:11","text_indopak_nastaleeq":"كَلَّا لَا وَزَرَ ۟ؕ"},{"id":5563,"verse_key":"75:12","text_indopak_nastaleeq":"اِلٰى رَبِّكَ یَوْمَىِٕذِ لْمُسْتَقَرُّ ۟ؕ"},{"id":5564,"verse_key":"75:13","text_indopak_nastaleeq":"یُنَبَّؤُا الْاِنْسَانُ یَوْمَىِٕذٍۭ بِمَا قَدَّمَ وَاَخَّرَ ۟ؕ"},{"id":5565,"verse_key":"75:14","text_indopak_nastaleeq":"بَلِ الْاِنْسَانُ عَلٰی نَفْسِهٖ بَصِیْرَةٌ ۟ۙ"},{"id":5566,"verse_key":"75:15","text_indopak_nastaleeq":"وَّلَوْ اَلْقٰى مَعَاذِیْرَهٗ ۟ؕ"},{"id":5567,"verse_key":"75:16","text_indopak_nastaleeq":"لَا تُحَرِّكْ بِهٖ لِسَانَكَ لِتَعْجَلَ بِهٖ ۟ؕ"},{"id":5568,"verse_key":"75:17","text_indopak_nastaleeq":"اِنَّ عَلَیْنَا جَمْعَهٗ وَقُرْاٰنَهٗ ۟ۚۖ"},{"id":5569,"verse_key":"75:18","text_indopak_nastaleeq":"فَاِذَا قَرَاْنٰهُ فَاتَّبِعْ قُرْاٰنَهٗ ۟ۚ"},{"id":5570,"verse_key":"75:19","text_indopak_nastaleeq":"ثُمَّ اِنَّ عَلَیْنَا بَیَانَهٗ ۟ؕ"},{"id":5571,"verse_key":"75:20","text_indopak_nastaleeq":"كَ