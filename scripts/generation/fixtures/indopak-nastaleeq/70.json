{"verses":[{"id":5376,"verse_key":"70:1","text_indopak_nastaleeq":"سَاَلَ سَآىِٕلٌۢ بِعَذَابٍ وَّاقِعٍ ۟ۙ"},{"id":5377,"verse_key":"70:2","text_indopak_nastaleeq":"لِّلْكٰفِرِیْنَ لَیْسَ لَهٗ دَافِعٌ ۟ۙ"},{"id":5378,"verse_key":"70:3","text_indopak_nastaleeq":"مِّنَ اللّٰهِ ذِی الْمَعَارِجِ ۟ؕ"},{"id":5379,"verse_key":"70:4","text_indopak_nastaleeq":"تَعْرُجُ الْمَلٰٓىِٕكَةُ وَالرُّوْحُ اِلَیْهِ فِیْ یَوْمٍ كَانَ مِقْدَارُهٗ خَمْسِیْنَ اَلْفَ سَنَةٍ ۟ۚ"},{"id":5380,"verse_key":"70:5","text_indopak_nastaleeq":"فَاصْبِرْ صَبْرًا جَمِیْلًا ۟"},{"id":5381,"verse_key":"70:6","text_indopak_nastaleeq":"اِنَّهُمْ یَرَوْنَهٗ بَعِیْدًا ۟ۙ"},{"id":5382,"verse_key":"70:7","text_indopak_nastaleeq":"وَّنَرٰىهُ قَرِیْبًا ۟ؕ"},{"id":5383,"verse_key":"70:8","text_indopak_nastaleeq":"یَوْمَ تَكُوْنُ السَّمَآءُ كَالْمُهْلِ ۟ۙ"},{"id":5384,"verse_key":"70:9","text_indopak_nastaleeq":"وَتَكُوْنُ الْجِبَالُ كَالْعِهْنِ ۟ۙ"},{"id":5385,"verse_key":"70:10","text_indopak_nastaleeq":"وَلَا یَسْـَٔلُ حَمِیْمٌ حَمِیْمًا ۟ۚۖ"},{"id":5386,"verse_key":"70:11","text_indopak_nastaleeq":"یُّبَصَّرُوْنَهُمْ ؕ یَوَدُّ الْمُجْرِمُ لَوْ یَفْتَدِیْ مِنْ عَذَابِ یَوْمِىِٕذٍ بِبَنِیْهِ ۟ۙ"},{"id":5387,"verse_key":"70:12","text_indopak_nastaleeq":"وَصَاحِبَتِهٖ وَاَخِیْهِ ۟ۙ"},{"id":5388,"verse_key":"70:13","text_indopak_nastaleeq":"وَفَصِیْلَتِهِ الَّتِیْ تُـْٔوِیْهِ ۟ۙ"},{"id":5389,"verse_key":"70:14","text_indopak_nastaleeq":"وَمَنْ فِی الْاَرْضِ جَمِیْعًا ۙ ثُمَّ یُنْجِیْهِ ۟ۙ"},{"id":5390,"verse_key":"70:15","text_indopak_nastaleeq":"كَلَّا ؕ اِنَّهَا لَظٰی ۟ۙ"},{"id":5391,"verse_key":"70:16","text_indopak_nastaleeq":"نَزَّاعَةً لِّلشَّوٰی ۟ۚۖ"},{"id":5392,"verse_key":"70:17","text_indopak_nastaleeq":"تَدْعُوْا مَنْ اَدْبَرَ وَتَوَلّٰی ۟ۙ"},{"id":5393,"verse_key":"70:18","text_indopak_nastaleeq":"وَجَمَعَ فَاَوْعٰی ۟"},{"id":5394,"verse_key":"70:19","text_indopak_nastaleeq":"اِنَّ الْاِنْسَانَ خُلِقَ هَلُوْعًا ۟ۙ"},{"id":5395,"verse_key":"70:20","text_indopak_nastaleeq":"اِذَا مَسَّهُ الشَّرُّ جَزُوْعًا ۟ۙ"},{"id":5396,"verse_key":"70:21","text_indopak_nastaleeq":"وَّاِذَا مَسَّهُ الْخَیْرُ مَنُوْعًا ۟ۙ"},{"id":5397,"verse_key":"70:22","text_indopak_nastaleeq":"اِلَّا الْمُصَلِّیْنَ ۟ۙ"},{"id":5398,"verse_key":"70:23","text_indopak_nastaleeq":"الَّذِیْنَ هُمْ عَلٰی صَلَاتِهِمْ دَآىِٕمُوْنَ ۟"},{"id":5399,"verse_key":"70:24","text_indopak_nastaleeq":"وَالَّذِیْنَ فِیْۤ اَمْوَالِهِمْ حَقٌّ مَّعْلُوْمٌ ۟"},{"id":5400,"verse_key":"70:25","text_indopak_nastaleeq":"لِّلسَّآىِٕلِ وَالْمَحْرُوْمِ ۟"},{"id":5401,"verse_key":"70:26","text_indopak_nastaleeq":"وَالَّذِیْنَ یُصَدِّقُوْنَ بِیَوْمِ الدِّیْنِ ۟"},{"id":5402,"verse_key":"70:27","text_indopak_nastaleeq":"وَالَّذِیْنَ هُمْ مِّنْ عَذَابِ رَبِّهِمْ مُّشْفِقُوْنَ ۟ۚ"},{"id":5403,"verse_key":"70:28","text_indopak_nastaleeq":"اِنَّ عَذَابَ رَبِّهِمْ غَیْرُ مَاْمُوْنٍ ۟"},{"id":5404,"verse_key":"70:29","text_indopak_nastaleeq":"وَالَّذِیْنَ هُمْ لِفُرُوْجِهِمْ حٰفِظُوْنَ ۟ۙ"},{"id":5405,"verse_key":"70:30","text_indopak_nastaleeq":"اِلَّا عَلٰۤی اَزْوَاجِهِمْ اَوْ مَا مَلَكَتْ اَیْمَانُهُمْ فَاِنَّهُمْ غَیْرُ مَلُوْمِیْنَ ۟ۚ"},{"id":5406,"verse_key":"70:31","text_indopak_nastaleeq":"فَمَنِ ابْتَغٰی وَرَآءَ ذٰلِكَ فَاُولٰٓىِٕكَ هُمُ الْعٰدُوْنَ ۟ۚ"},{"id":5407,"verse_key":"70:32","text_indopak_nastaleeq":"وَالَّذِیْنَ هُمْ لِاَمٰنٰتِهِمْ وَعَهْدِهِمْ رٰعُوْنَ ۟"},{"id":5408,"verse_key":"70:33","text_indopak_nastaleeq":"وَالَّذِیْنَ هُمْ بِشَهٰدٰتِهِمْ قَآىِٕمُوْنَ ۟"},{"id":5409,"verse_key":"70:34","text_indopak_nastaleeq":"وَالَّذِیْنَ هُمْ عَلٰی صَلَاتِهِمْ یُحَافِظُوْنَ ۟ؕ"},{"id":5410,"verse_key":"70:35","text_indopak_nastaleeq":"اُولٰٓىِٕكَ فِیْ جَنّٰتٍ مُّكْرَمُوْنَ ۟ؕ۠"},{"id":5411,"verse_key":"70:36","text_indopak_nastaleeq":"فَمَالِ الَّذِیْنَ كَفَرُوْا قِبَلَكَ مُهْطِعِیْنَ ۟ۙ"},{"id":5412,"verse_key":"70:37","text_indopak_nastaleeq":"عَنِ الْیَمِیْنِ وَعَنِ الشِّمَالِ عِزِیْنَ ۟"},{"id":5413,"verse_key":"70:38","text_indopak_nastaleeq":"اَیَطْمَعُ كُلُّ امْرِئٍ مِّنْهُمْ اَنْ یُّدْخَلَ جَنَّةَ نَعِیْمٍ ۟ۙ"},{"id":5414,"verse_key":"70:39","text_indopak_nastaleeq":"كَلَّا ؕ اِنَّا خَلَقْنٰهُمْ مِّمَّا یَعْلَمُوْنَ ۟"},{"id":5415,"verse_key":"70:40","text_indopak_nastaleeq":"فَلَاۤ اُقْسِمُ بِرَبِّ الْمَشٰرِقِ وَالْمَغٰرِبِ اِنَّا لَقٰدِرُوْنَ ۟ۙ"},{"id":5416,"verse_key":"70:41","text_indopak_nastaleeq":"عَلٰۤی اَنْ نُّبَدِّلَ خَیْرًا مِّنْهُمْ ۙ وَمَا نَحْنُ بِمَسْبُوْقِیْنَ ۟"},{"id":5417,"verse_key":"70:42","text_indopak_nastaleeq":"فَذَرْهُمْ یَخُوْضُوْا وَیَلْعَبُوْا حَتّٰی یُلٰقُوْا یَوْمَهُمُ الَّذِیْ یُوْعَدُوْنَ ۟ۙ"},{"id":5418,"verse_key":"70:43","text_indopak_nastaleeq":"یَوْمَ یَخْرُجُوْنَ مِنَ الْاَجْدَاثِ سِرَاعًا كَاَنَّهُمْ اِلٰی نُصُبٍ یُّوْفِضُوْنَ ۟ۙ"},{"id":5419,"verse_key":"70:44","text_indopak_nastaleeq":"خَاشِعَةً اَبْصَارُهُمْ تَرْهَقُهُمْ ذِلَّةٌ ؕ ذٰلِكَ الْیَوْمُ الَّذِیْ كَانُوْا یُوْعَدُوْنَ ۟۠"}],"meta":{"filters":{"chapter_number":"70"}}}