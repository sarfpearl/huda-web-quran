{"verses":[{"id":5994,"verse_key":"89:1","text_indopak_nastaleeq":"وَالْفَجْرِ ۟ۙ"},{"id":5995,"verse_key":"89:2","text_indopak_nastaleeq":"وَلَیَالٍ عَشْرٍ ۟ۙ"},{"id":5996,"verse_key":"89:3","text_indopak_nastaleeq":"وَّالشَّفْعِ وَالْوَتْرِ ۟ۙ"},{"id":5997,"verse_key":"89:4","text_indopak_nastaleeq":"وَالَّیْلِ اِذَا یَسْرِ ۟ۚ"},{"id":5998,"verse_key":"89:5","text_indopak_nastaleeq":"هَلْ فِیْ ذٰلِكَ قَسَمٌ لِّذِیْ حِجْرٍ ۟ؕ"},{"id":5999,"verse_key":"89:6","text_indopak_nastaleeq":"اَلَمْ تَرَ كَیْفَ فَعَلَ رَبُّكَ بِعَادٍ ۟"},{"id":6000,"verse_key":"89:7","text_indopak_nastaleeq":"اِرَمَ ذَاتِ الْعِمَادِ ۟"},{"id":6001,"verse_key":"89:8","text_indopak_nastaleeq":"الَّتِیْ لَمْ یُخْلَقْ مِثْلُهَا فِی الْبِلَادِ ۟"},{"id":6002,"verse_key":"89:9","text_indopak_nastaleeq":"وَثَمُوْدَ الَّذِیْنَ جَابُوا الصَّخْرَ بِالْوَادِ ۟"},{"id":6003,"verse_key":"89:10","text_indopak_nastaleeq":"وَفِرْعَوْنَ ذِی الْاَوْتَادِ ۟"},{"id":6004,"verse_key":"89:11","text_indopak_nastaleeq":"الَّذِیْنَ طَغَوْا فِی الْبِلَادِ ۟"},{"id":6005,"verse_key":"89:12","text_indopak_nastaleeq":"فَاَكْثَرُوْا فِیْهَا الْفَسَادَ ۟"},{"id":6006,"verse_key":"89:13","text_indopak_nastaleeq":"فَصَبَّ عَلَیْهِمْ رَبُّكَ سَوْطَ عَذَابٍ ۟ۚۙ"},{"id":6007,"verse_key":"89:14","text_indopak_nastaleeq":"اِنَّ رَبَّكَ لَبِالْمِرْصَادِ ۟ؕ"},{"id":6008,"verse_key":"89:15","text_indopak_nastaleeq":"فَاَمَّا الْاِنْسَانُ اِذَا مَا ابْتَلٰىهُ رَبُّهٗ فَاَكْرَمَهٗ وَنَعَّمَهٗ ۙ۬ فَیَقُوْلُ رَبِّیْۤ اَكْرَمَنِ ۟ؕ"},{"id":6009,"verse_key":"89:16","text_indopak_nastaleeq":"وَاَمَّاۤ اِذَا مَا ابْتَلٰىهُ فَقَدَرَ عَلَیْهِ رِزْقَهٗ ۙ۬ فَیَقُوْلُ رَبِّیْۤ اَهَانَنِ ۟ۚ"},{"id":6010,"verse_key":"89:17","text_indopak_nastaleeq":"كَلَّا بَلْ لَّا تُكْرِمُوْنَ الْیَتِیْمَ ۟ۙ"},{"id":6011,"verse_key":"89:18","text_indopak_nastaleeq":"وَلَا تَحٰٓضُّوْنَ عَلٰی طَعَامِ الْمِسْكِیْنِ ۟ۙ"},{"id":6012,"verse_key":"89:19","text_indopak_nastaleeq":"وَتَاْكُلُوْنَ التُّرَاثَ اَكْلًا لَّمًّا ۟ۙ"},{"id":6013,"verse_key":"89:20","text_indopak_nastaleeq":"وَّتُحِبُّوْنَ الْمَالَ حُبًّا جَمًّا ۟ؕ"},{"id":6014,"verse_key":"89:21","text_indopak_nastaleeq":"كَلَّاۤ اِذَا دُكَّتِ الْاَرْضُ دَكًّا دَكًّا ۟ۙ"},{"id":6015,"verse_key":"89:22","text_indopak_nastaleeq":"وَّجَآءَ رَبُّكَ وَالْمَلَكُ صَفًّا صَفًّا ۟ۚ"},{"id":6016,"verse_key":"89:23","text_indopak_nastaleeq":"وَجِایْٓءَ یَوْمَىِٕذٍۭ بِجَهَنَّمَ ۙ۬ یَوْمَىِٕذٍ یَّتَذَكَّرُ الْاِنْسَانُ وَاَنّٰی لَهُ الذِّكْرٰی ۟ؕ"},{"id":6017,"verse_key":"89:24","text_indopak_nastaleeq":"یَقُوْلُ یٰلَیْتَنِیْ قَدَّمْتُ لِحَیَاتِیْ ۟ۚ"},{"id":6018,"verse_key":"89:25","text_indopak_nastaleeq":"فَیَوْمَىِٕذٍ لَّا یُعَذِّبُ عَذَابَهٗۤ اَحَدٌ ۟ۙ"},{"id":6019,"verse_key":"89:26","text_indopak_nastaleeq":"وَّلَا یُوْثِقُ وَثَاقَهٗۤ اَحَدٌ ۟ؕ"},{"id":6020,"verse_key":"89:27","text_indopak_nastaleeq":"یٰۤاَیَّتُهَا النَّفْسُ الْمُطْمَىِٕنَّةُ ۟ۗۖ"},{"id":6021,"verse_key":"89:28","text_indopak_nastaleeq":"ارْجِعِیْۤ اِلٰی رَبِّكِ رَاضِیَةً مَّرْضِیَّةً ۟ۚ"},{"id":6022,"verse_key":"89:29","text_indopak_nastaleeq":"فَادْخُلِیْ فِیْ عِبٰدِیْ ۟ۙ"},{"id":6023,"verse_key":"89:30","text_indopak_nastaleeq":"وَادْخُلِیْ جَنَّتِیْ ۟۠"}],"meta":{"filters":{"chapter_number":"89"}}}