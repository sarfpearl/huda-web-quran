{"verses":[{"id":5623,"verse_key":"77:1","text_indopak_nastaleeq":"وَالْمُرْسَلٰتِ عُرْفًا ۟ۙ"},{"id":5624,"verse_key":"77:2","text_indopak_nastaleeq":"فَالْعٰصِفٰتِ عَصْفًا ۟ۙ"},{"id":5625,"verse_key":"77:3","text_indopak_nastaleeq":"وَّالنّٰشِرٰتِ نَشْرًا ۟ۙ"},{"id":5626,"verse_key":"77:4","text_indopak_nastaleeq":"فَالْفٰرِقٰتِ فَرْقًا ۟ۙ"},{"id":5627,"verse_key":"77:5","text_indopak_nastaleeq":"فَالْمُلْقِیٰتِ ذِكْرًا ۟ۙ"},{"id":5628,"verse_key":"77:6","text_indopak_nastaleeq":"عُذْرًا اَوْ نُذْرًا ۟ۙ"},{"id":5629,"verse_key":"77:7","text_indopak_nastaleeq":"اِنَّمَا تُوْعَدُوْنَ لَوَاقِعٌ ۟ؕ"},{"id":5630,"verse_key":"77:8","text_indopak_nastaleeq":"فَاِذَا النُّجُوْمُ طُمِسَتْ ۟ۙ"},{"id":5631,"verse_key":"77:9","text_indopak_nastaleeq":"وَاِذَا السَّمَآءُ فُرِجَتْ ۟ۙ"},{"id":5632,"verse_key":"77:10","text_indopak_nastaleeq":"وَاِذَا الْجِبَالُ نُسِفَتْ ۟ۙ"},{"id":5633,"verse_key":"77:11","text_indopak_nastaleeq":"وَاِذَا الرُّسُلُ اُقِّتَتْ ۟ؕ"},{"id":5634,"verse_key":"77:12","text_indopak_nastaleeq":"لِاَیِّ یَوْمٍ اُجِّلَتْ ۟ؕ"},{"id":5635,"verse_key":"77:13","text_indopak_nastaleeq":"لِیَوْمِ الْفَصْلِ ۟ۚ"},{"id":5636,"verse_key":"77:14","text_indopak_nastaleeq":"وَمَاۤ اَدْرٰىكَ مَا یَوْمُ الْفَصْلِ ۟ؕ"},{"id":5637,"verse_key":"77:15","text_indopak_nastaleeq":"وَیْلٌ یَّوْمَىِٕذٍ لِّلْمُكَذِّبِیْنَ ۟"},{"id":5638,"verse_key":"77:16","text_indopak_nastaleeq":"اَلَمْ نُهْلِكِ الْاَوَّلِیْنَ ۟ؕ"},{"id":5639,"verse_key":"77:17","text_indopak_nastaleeq":"ثُمَّ نُتْبِعُهُمُ الْاٰخِرِیْنَ ۟"},{"id":5640,"verse_key":"77:18","text_indopak_nastaleeq":"كَذٰلِكَ نَفْعَلُ بِالْمُجْرِمِیْنَ ۟"},{"id":5641,"verse_key":"77:19","text_indopak_nastaleeq":"وَیْلٌ یَّوْمَىِٕذٍ لِّلْمُكَذِّبِیْنَ ۟"},{"id":5642,"verse_key":"77:20","text_indopak_nastaleeq":"اَلَمْ نَخْلُقْكُّمْ مِّنْ مَّآءٍ مَّهِیْنٍ ۟ۙ"},{"id":5643,"verse_key":"77:21","text_indopak_nastaleeq":"فَجَعَلْنٰهُ فِیْ قَرَارٍ مَّكِیْنٍ ۟ۙ"},{"id":5644,"verse_key":"77:22","text_indopak_nastaleeq"