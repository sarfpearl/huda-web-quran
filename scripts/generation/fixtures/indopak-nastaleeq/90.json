{"verses":[{"id":6024,"verse_key":"90:1","text_indopak_nastaleeq":"لَاۤ اُقْسِمُ بِهٰذَا الْبَلَدِ ۟ۙ"},{"id":6025,"verse_key":"90:2","text_indopak_nastaleeq":"وَاَنْتَ حِلٌّۢ بِهٰذَا الْبَلَدِ ۟ۙ"},{"id":6026,"verse_key":"90:3","text_indopak_nastaleeq":"وَوَالِدٍ وَّمَا وَلَدَ ۟ۙ"},{"id":6027,"verse_key":"90:4","text_indopak_nastaleeq":"لَقَدْ خَلَقْنَا الْاِنْسَانَ فِیْ كَبَدٍ ۟ؕ"},{"id":6028,"verse_key":"90:5","text_indopak_nastaleeq":"اَیَحْسَبُ اَنْ لَّنْ یَّقْدِرَ عَلَیْهِ اَحَدٌ ۟ۘ"},{"id":6029,"verse_key":"90:6","text_indopak_nastaleeq":"یَقُوْلُ اَهْلَكْتُ مَالًا لُّبَدًا ۟ؕ"},{"id":6030,"verse_key":"90:7","text_indopak_nastaleeq":"اَیَحْسَبُ اَنْ لَّمْ یَرَهٗۤ اَحَدٌ ۟ؕ"},{"id":6031,"verse_key":"90:8","text_indopak_nastaleeq":"اَلَمْ نَجْعَلْ لَّهٗ عَیْنَیْنِ ۟ۙ"},{"id":6032,"verse_key":"90:9","text_indopak_nastaleeq":"وَلِسَانًا وَّشَفَتَیْنِ ۟ۙ"},{"id":6033,"verse_key":"90:10","text_indopak_nastaleeq":"وَهَدَیْنٰهُ النَّجْدَیْنِ ۟ۚ"},{"id":6034,"verse_key":"90:11","text_indopak_nastaleeq":"فَلَا اقْتَحَمَ الْعَقَبَةَ ۟ؗۖ"},{"id":6035,"verse_key":"90:12","text_indopak_nastaleeq":"وَمَاۤ اَدْرٰىكَ مَا الْعَقَبَةُ ۟ؕ"},{"id":6036,"verse_key":"90:13","text_indopak_nastaleeq":"فَكُّ رَقَبَةٍ ۟ۙ"},{"id":6037,"verse_key":"90:14","text_indopak_nastaleeq":"اَوْ اِطْعٰمٌ فِیْ یَوْمٍ ذِیْ مَسْغَبَةٍ ۟ۙ"},{"id":6038,"verse_key":"90:15","text_indopak_nastaleeq":"یَّتِیْمًا ذَا مَقْرَبَةٍ ۟ۙ"},{"id":6039,"verse_key":"90:16","text_indopak_nastaleeq":"اَوْ مِسْكِیْنًا ذَا مَتْرَبَةٍ ۟ؕ"},{"id":6040,"verse_key":"90:17","text_indopak_nastaleeq":"ثُمَّ كَانَ مِنَ الَّذِیْنَ اٰمَنُوْا وَتَوَاصَوْا بِالصَّبْرِ وَتَوَاصَوْا بِالْمَرْحَمَةِ ۟ؕ"},{"id":6041,"verse_key":"90:18","text_indopak_nastaleeq":"اُولٰٓىِٕكَ اَصْحٰبُ الْمَیْمَنَةِ ۟ؕ"},{"id":6042,"verse_key":"90:19","text_indopak_nastaleeq":"وَالَّذِیْنَ كَفَرُوْا بِاٰیٰتِنَا هُمْ اَصْحٰبُ الْمَشْـَٔمَةِ ۟ؕ"},{"id":6043,"verse_key":"90:20","text_indopak_nastaleeq":"عَلَیْهِمْ نَارٌ مُّؤْصَدَةٌ ۟۠"}],