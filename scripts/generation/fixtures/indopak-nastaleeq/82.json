{"verses":[{"id":5830,"verse_key":"82:1","text_indopak_nastaleeq":"اِذَا السَّمَآءُ انْفَطَرَتْ ۟ۙ"},{"id":5831,"verse_key":"82:2","text_indopak_nastaleeq":"وَاِذَا الْكَوَاكِبُ انْتَثَرَتْ ۟ۙ"},{"id":5832,"verse_key":"82:3","text_indopak_nastaleeq":"وَاِذَا الْبِحَارُ فُجِّرَتْ ۟ۙ"},{"id":5833,"verse_key":"82:4","text_indopak_nastaleeq":"وَاِذَا الْقُبُوْرُ بُعْثِرَتْ ۟ۙ"},{"id":5834,"verse_key":"82:5","text_indopak_nastaleeq":"عَلِمَتْ نَفْسٌ مَّا قَدَّمَتْ وَاَخَّرَتْ ۟ؕ"},{"id":5835,"verse_key":"82:6","text_indopak_nastaleeq":"یٰۤاَیُّهَا الْاِنْسَانُ مَا غَرَّكَ بِرَبِّكَ الْكَرِیْمِ ۟ۙ"},{"id":5836,"verse_key":"82:7","text_indopak_nastaleeq":"الَّذِیْ خَلَقَكَ فَسَوّٰىكَ فَعَدَلَكَ ۟ۙ"},{"id":5837,"verse_key":"82:8","text_indopak_nastaleeq":"فِیْۤ اَیِّ صُوْرَةٍ مَّا شَآءَ رَكَّبَكَ ۟ؕ"},{"id":5838,"verse_key":"82:9","text_indopak_nastaleeq":"كَلَّا بَلْ تُكَذِّبُوْنَ بِالدِّیْنِ ۟ۙ"},{"id":5839,"verse_key":"82:10","text_indopak_nastaleeq":"وَاِنَّ عَلَیْكُمْ لَحٰفِظِیْنَ ۟ۙ"},{"id":5840,"verse_key":"82:11","text_indopak_nastaleeq":"كِرَامًا كَاتِبِیْنَ ۟ۙ"},{"id":5841,"verse_key":"82:12","text_indopak_nastaleeq":"یَعْلَمُوْنَ مَا تَفْعَلُوْنَ ۟"},{"id":5842,"verse_key":"82:13","text_indopak_nastaleeq":"اِنَّ الْاَبْرَارَ لَفِیْ نَعِیْمٍ ۟ۙ"},{"id":5843,"verse_key":"82:14","text_indopak_nastaleeq":"وَاِنَّ الْفُجَّارَ لَفِیْ جَحِیْمٍ ۟ۚۖ"},{"id":5844,"verse_key":"82:15","text_indopak_nastaleeq":"یَّصْلَوْنَهَا یَوْمَ الدِّیْنِ ۟"},{"id":5845,"verse_key":"82:16","text_indopak_nastaleeq":"وَمَا هُمْ عَنْهَا بِغَآىِٕبِیْنَ ۟ؕ"},{"id":5846,"verse_key":"82:17","text_indopak_nastaleeq":"وَمَاۤ اَدْرٰىكَ مَا یَوْمُ الدِّیْنِ ۟ۙ"},{"id":5847,"verse_key":"82:18","text_indopak_nastaleeq":"ثُمَّ مَاۤ اَدْرٰىكَ مَا یَوْمُ الدِّیْنِ ۟ؕ"},{"id":5848,"verse_key":"82:19","text_indopak_nastaleeq":"یَوْمَ لَا تَمْلِكُ نَفْسٌ لِّنَفْسٍ شَیْـًٔا ؕ وَالْاَمْرُ یَوْمَىِٕذٍ لِّلّٰهِ ۟۠"}],"meta":{"filters":{"chapter_number":"82"}}}