{"verses":[{"id":6080,"verse_key":"93:1","text_indopak_nastaleeq":"وَالضُّحٰی ۟ۙ"},{"id":6081,"verse_key":"93:2","text_indopak_nastaleeq":"وَالَّیْلِ اِذَا سَجٰی ۟ۙ"},{"id":6082,"verse_key":"93:3","text_indopak_nastaleeq":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلٰی ۟ؕ"},{"id":6083,"verse_key":"93:4","text_indopak_nastaleeq":"وَلَلْاٰخِرَةُ خَیْرٌ لَّكَ مِنَ الْاُوْلٰی ۟ؕ"},{"id":6084,"verse_key":"93:5","text_indopak_nastaleeq":"وَلَسَوْفَ یُعْطِیْكَ رَبُّكَ فَتَرْضٰی ۟ؕ"},{"id":6085,"verse_key":"93:6","text_indopak_nastaleeq":"اَلَمْ یَجِدْكَ یَتِیْمًا فَاٰوٰی ۪۟"},{"id":6086,"verse_key":"93:7","text_indopak_nastaleeq":"وَوَجَدَكَ ضَآلًّا فَهَدٰی ۪۟"},{"id":6087,"verse_key":"93:8","text_indopak_nastaleeq":"وَوَجَدَكَ عَآىِٕلًا فَاَغْنٰی ۟ؕ"},{"id":6088,"verse_key":"93:9","text_indopak_nastaleeq":"فَاَمَّا الْیَتِیْمَ فَلَا تَقْهَرْ ۟ؕ"},{"id":6089,"verse_key":"93:10","text_indopak_nastaleeq":"وَاَمَّا السَّآىِٕلَ فَلَا تَنْهَرْ ۟ؕ"},{"id":6090,"verse_key":"93:11","text_indopak_nastaleeq":"وَاَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ ۟۠"}],"meta":{"filters":{"chapter_number":"93"}}}