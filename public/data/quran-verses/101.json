[{"surahNumber":101,"ayahNumber":1,"textArabic":"ٱلْقَارِعَةُ","textEnglish":"The Striking Calamity -","textTamil":"திடுக்கிடச் செய்யும் (நிகழ்ச்சி).","verseKey":"101:1","timestampFrom":0,"timestampTo":1.91},{"surahNumber":101,"ayahNumber":2,"textArabic":"مَا ٱلْقَارِعَةُ","textEnglish":"What is the Striking Calamity?","textTamil":"திடுக்கிடச் செய்யும் (நிகழ்ச்சி) என்ன?","verseKey":"101:2","timestampFrom":1.91,"timestampTo":3.66},{"surahNumber":101,"ayahNumber":3,"textArabic":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","textEnglish":"And what can make you know what is the Striking Calamity?","textTamil":"திடுக்கிடச் செய்யும் (நிகழ்ச்சி) என்ன வென்று உமக்கு எது அறிவித்தது?","verseKey":"101:3","timestampFrom":3.66,"timestampTo":8.23},{"surahNumber":101,"ayahNumber":4,"textArabic":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","textEnglish":"It is the Day when people will be like moths, dispersed,","textTamil":"அந்நாளில் சிதறடிக்கப்பட்ட ஈசல்களைப் போன்று மனிதர்கள் ஆகிவிடுவார்கள்.","verseKey":"101:4","timestampFrom":8.23,"timestampTo":15.02},{"surahNumber":101,"ayahNumber":5,"textArabic":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","textEnglish":"And the mountains will be like wool, fluffed up.","textTamil":"மேலும், மலைகள் கொட்டப்பட்ட பஞ்சைப் போன்று ஆகிவிடும்.","verseKey":"101:5","timestampFrom":15.02,"timestampTo":21.42},{"surahNumber":101,"ayahNumber":6,"textArabic":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","textEnglish":"Then as for one whose scales are heavy [with good deeds],","textTamil":"எனவே, (அந்நாளில்) எவருடைய (நன்மையின்) நிறை கனத்ததோ-","verseKey":"101:6","timestampFrom":21.42,"timestampTo":26.8},{"surahNumber":101,"ayahNumber":7,"textArabic":"فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ","textEnglish":"He will be in a pleasant life.","textTamil":"அவர் திருப்தி பொருந்திய வாழ்வில் இருப்பார்.","verseKey":"101:7","timestampFrom":26.8,"timestampTo":30.43},{"surahNumber":101,"ayahNumber":8,"textArabic":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","textEnglish":"But as for one whose scales are light,","textTamil":"ஆனால் எவனுடைய (நன்மையின்) நிறை இலேசாக இருக்கிறதோ-","verseKey":"101:8","timestampFrom":30.43,"timestampTo":35.45},{"surahNumber":101,"ayahNumber":9,"textArabic":"فَأُمُّهُۥ هَاوِيَةٌۭ","textEnglish":"His refuge will be an abyss.","textTamil":"அவன் தங்குமிடம் \"ஹாவியா\" தான்.","verseKey":"101:9","timestampFrom":35.45,"timestampTo":38.74},{"surahNumber":101,"ayahNumber":10,"textArabic":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","textEnglish":"And what can make you know what that is?","textTamil":"இன்னும் ('ஹாவியா') என்ன என்று உமக்கு அறிவித்தது எது?","verseKey":"101:10","timestampFrom":38.74,"timestampTo":44.28},{"surahNumber":101,"ayahNumber":11,"textArabic":"نَارٌ حَامِيَةٌۢ","textEnglish":"It is a Fire, intensely hot.","textTamil":"அது சுட்டெரிக்கும் (நரகத்தின்) தீக்கிடங்காகும்.","verseKey":"101:11","timestampFrom":44.28,"timestampTo":48.75}]