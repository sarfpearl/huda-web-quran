[{"surahNumber":107,"ayahNumber":1,"textArabic":"أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","textEnglish":"Have you seen the one who denies the Recompense?","textTamil":"(நபியே!) நியாயத்தீர்ப்பைப் பொய்ப்பிக்கின்றானே அவனை நீர் பார்த்தீரா?","verseKey":"107:1","timestampFrom":0,"timestampTo":3.74},{"surahNumber":107,"ayahNumber":2,"textArabic":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","textEnglish":"For that is the one who drives away the orphan","textTamil":"பின்னர் அவன்தான் அநாதைகளை விரட்டுகிறான்.","verseKey":"107:2","timestampFrom":3.74,"timestampTo":7.71},{"surahNumber":107,"ayahNumber":3,"textArabic":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","textEnglish":"And does not encourage the feeding of the poor.","textTamil":"மேலும், ஏழைக்கு உணவளிப்பதின் பேரிலும் அவன் தூண்டுவதில்லை.","verseKey":"107:3","timestampFrom":7.71,"timestampTo":12.49},{"surahNumber":107,"ayahNumber":4,"textArabic":"فَوَيْلٌۭ لِّلْمُصَلِّينَ","textEnglish":"So woe to those who pray","textTamil":"இன்னும், (கவனமற்ற) தொழுகையாளிகளுக்குக் கேடுதான்.","verseKey":"107:4","timestampFrom":12.49,"timestampTo":15.21},{"surahNumber":107,"ayahNumber":5,"textArabic":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","textEnglish":"[But] who are heedless of their prayer -","textTamil":"அவர்கள் எத்தகையோர் என்றால் தம் தொழுகையில் பராமுகமாக(வும், அசிரத்தையாக)வும் இருப்போர்.","verseKey":"107:5","timestampFrom":15.21,"timestampTo":20.98},{"surahNumber":107,"ayahNumber":6,"textArabic":"ٱلَّذِينَ هُمْ يُرَآءُونَ","textEnglish":"Those who make show [of their deeds]","textTamil":"அவர்கள் பிறருக்குக் காண்பிக்(கவே தான் தொழு)கிறார்கள்.","verseKey":"107:6","timestampFrom":20.98,"timestampTo":25.66},{"surahNumber":107,"ayahNumber":7,"textArabic":"وَيَمْنَعُونَ ٱلْمَاعُونَ","textEnglish":"And withhold [simple] assistance.","textTamil":"மேலும், அற்பமான (புழங்கும்) பொருள்களைக் (கொடுப்பதை விட்டும்) தடுக்கிறார்கள்.","verseKey":"107:7","timestampFrom":25.66,"timestampTo":30.81}]