[{"surahNumber":109,"ayahNumber":1,"textArabic":"قُلْ يَٰٓأَيُّهَا ٱلْكَٰفِرُونَ","textEnglish":"Say, \"O disbelievers,","textTamil":"(நபியே!) நீர் சொல்வீராக: \"காஃபிர்களே!","verseKey":"109:1","timestampFrom":0,"timestampTo":3.63},{"surahNumber":109,"ayahNumber":2,"textArabic":"لَآ أَعْبُدُ مَا تَعْبُدُونَ","textEnglish":"I do not worship what you worship.","textTamil":"நீங்கள் வணங்குபவற்றை நான் வணங்கமாட்டேன்.","verseKey":"109:2","timestampFrom":3.63,"timestampTo":7.42},{"surahNumber":109,"ayahNumber":3,"textArabic":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","textEnglish":"Nor are you worshippers of what I worship.","textTamil":"இன்னும், நான் வணங்குகிறவனை நீங்கள் வணங்குகிறவர்களல்லர்.","verseKey":"109:3","timestampFrom":7.42,"timestampTo":12.1},{"surahNumber":109,"ayahNumber":4,"textArabic":"وَلَآ أَنَا۠ عَابِدٌۭ مَّا عَبَدتُّمْ","textEnglish":"Nor will I be a worshipper of what you worship.","textTamil":"அன்றியும், நீங்கள் வணங்குபவற்றை நான் வணங்குபவனல்லன்.","verseKey":"109:4","timestampFrom":12.1,"timestampTo":16.7},{"surahNumber":109,"ayahNumber":5,"textArabic":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","textEnglish":"Nor will you be worshippers of what I worship.","textTamil":"மேலும், நான் வணங்குபவனை நீங்கள் வணங்குபவர்கள் அல்லர்.","verseKey":"109:5","timestampFrom":16.7,"timestampTo":21.61},{"surahNumber":109,"ayahNumber":6,"textArabic":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ","textEnglish":"For you is your religion, and for me is my religion.\"","textTamil":"உங்களுக்கு உங்களுடைய மார்க்கம்; எனக்கு என்னுடைய மார்க்கம்.\"","verseKey":"109:6","timestampFrom":21.61,"timestampTo":26.78}]