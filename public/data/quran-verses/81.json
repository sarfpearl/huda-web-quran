[{"surahNumber":81,"ayahNumber":1,"textArabic":"إِذَا ٱلشَّمْسُ كُوِّرَتْ","textEnglish":"When the sun is wrapped up [in darkness]","textTamil":"சூரியன் (ஒளியில்லாததாகச்) சுருட்டப்படும் போது","verseKey":"81:1","timestampFrom":0,"timestampTo":2.22},{"surahNumber":81,"ayahNumber":2,"textArabic":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ","textEnglish":"And when the stars fall, dispersing,","textTamil":"நட்சத்திரங்கள் (ஒளியிழந்து) உதிர்ந்து விழும்போது-","verseKey":"81:2","timestampFrom":2.22,"timestampTo":5.3},{"surahNumber":81,"ayahNumber":3,"textArabic":"وَإِذَا ٱلْجِبَالُ سُيِّرَتْ","textEnglish":"And when the mountains are removed","textTamil":"மலைகள் பெயர்க்கப்படும் போது-","verseKey":"81:3","timestampFrom":5.3,"timestampTo":8.23},{"surahNumber":81,"ayahNumber":4,"textArabic":"وَإِذَا ٱلْعِشَارُ عُطِّلَتْ","textEnglish":"And when full-term she-camels are neglected","textTamil":"சூல் நிறைந்த ஒட்டகைகள் (கவனிப்பாரற்று) விடப்படும் போது-","verseKey":"81:4","timestampFrom":8.23,"timestampTo":10.63},{"surahNumber":81,"ayahNumber":5,"textArabic":"وَإِذَا ٱلْوُحُوشُ حُشِرَتْ","textEnglish":"And when the wild beasts are gathered","textTamil":"காட்டு மிருகங்கள் (மனிதர்களுடனும், இதர பிராணிகளுடனும்) ஒன்று சேர்க்கப்படும்போது-","verseKey":"81:5","timestampFrom":10.63,"timestampTo":13.03},{"surahNumber":81,"ayahNumber":6,"textArabic":"وَإِذَا ٱلْبِحَارُ سُجِّرَتْ","textEnglish":"And when the seas are filled with flame","textTamil":"கடல்கள் தீ மூட்டப்படும்போது-","verseKey":"81:6","timestampFrom":13.03,"timestampTo":15.64},{"surahNumber":81,"ayahNumber":7,"textArabic":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ","textEnglish":"And when the souls are paired","textTamil":"உயிர்கள் ஒன்றிணைக்கப்படும் போது-","verseKey":"81:7","timestampFrom":15.64,"timestampTo":18.57},{"surahNumber":81,"ayahNumber":8,"textArabic":"وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ","textEnglish":"And when the girl [who was] buried alive is asked","textTamil":"உயிருடன் புதைக்கப்பட்ட பெண் (குழந்தை) வினவப்படும் போது-","verseKey":"81:8","timestampFrom":18.57,"timestampTo":21.18},{"surahNumber":81,"ayahNumber":9,"textArabic":"بِأَىِّ ذَنۢبٍۢ قُتِلَتْ","textEnglish":"For what sin she was killed","textTamil":"\"எந்தக் குற்றத்திற்காக அது கொல்லப்பட்டது?\" என்று-","verseKey":"81:9","timestampFrom":21.18,"timestampTo":24.42},{"surahNumber":81,"ayahNumber":10,"textArabic":"وَإِذَا ٱلصُّحُفُ نُشِرَتْ","textEnglish":"And when the pages are made public","textTamil":"பட்டோலைகள் விரிக்கப்படும் போது-","verseKey":"81:10","timestampFrom":24.42,"timestampTo":26.64},{"surahNumber":81,"ayahNumber":11,"textArabic":"وَإِذَا ٱلسَّمَآءُ كُشِطَتْ","textEnglish":"And when the sky is stripped away","textTamil":"வானம் அகற்றப்படும் போது-","verseKey":"81:11","timestampFrom":26.64,"timestampTo":30.17},{"surahNumber":81,"ayahNumber":12,"textArabic":"وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ","textEnglish":"And when Hellfire is set ablaze","textTamil":"நரகம் கொழுந்துவிட்டு எரியுமாறு செய்யப்படும் போது-","verseKey":"81:12","timestampFrom":30.17,"timestampTo":32.63},{"surahNumber":81,"ayahNumber":13,"textArabic":"وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ","textEnglish":"And when Paradise is brought near,","textTamil":"சுவர்க்கம் சமீபமாக கொண்டு வரப்படும்போது-","verseKey":"81:13","timestampFrom":32.63,"timestampTo":35.32},{"surahNumber":81,"ayahNumber":14,"textArabic":"عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ","textEnglish":"A soul will [then] know what it has brought [with it].","textTamil":"ஒவ்வோர் ஆத்மாவும், தான் கொண்டு வந்ததை அறிந்து கொள்ளும்.","verseKey":"81:14","timestampFrom":35.32,"timestampTo":38.64},{"surahNumber":81,"ayahNumber":15,"textArabic":"فَلَآ أُقْسِمُ بِٱلْخُنَّسِ","textEnglish":"So I swear by the retreating stars -","textTamil":"எனவே, பின்னே விலகிச் செல்பவை (கிரகங்களின்) மீது சத்தியமாக-","verseKey":"81:15","timestampFrom":38.64,"timestampTo":41.46},{"surahNumber":81,"ayahNumber":16,"textArabic":"ٱلْجَوَارِ ٱلْكُنَّسِ","textEnglish":"Those that run [their courses] and disappear -","textTamil":"முன் சென்று கொண்டிருப்பவை மறைபவை (மீதும்),","verseKey":"81:16","timestampFrom":41.46,"timestampTo":43.6},{"surahNumber":81,"ayahNumber":17,"textArabic":"وَٱلَّيْلِ إِذَا عَسْعَسَ","textEnglish":"And by the night as it closes in","textTamil":"பின்வாங்கிச் செல்லும் இரவின் மீதும்,","verseKey":"81:17","timestampFrom":43.6,"timestampTo":45.82},{"surahNumber":81,"ayahNumber":18,"textArabic":"وَٱلصُّبْحِ إِذَا تَنَفَّسَ","textEnglish":"And by the dawn when it breathes","textTamil":"மூச்சுவிட்டுக் கொண்டெழும் வைகறையின் மீதும் சத்தியமாக.","verseKey":"81:18","timestampFrom":45.82,"timestampTo":48.38},{"surahNumber":81,"ayahNumber":19,"textArabic":"إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ","textEnglish":"[That] indeed, the Qur'an is a word [conveyed by] a noble messenger","textTamil":"நிச்சயமாக (இக்குர்ஆன்) மிகவும் கண்ணியமிக்க ஒரு தூதுவர் (ஜிப்ரயீல் மூலம் வந்த) சொல்லாகும்.","verseKey":"81:19","timestampFrom":48.38,"timestampTo":52.53},{"surahNumber":81,"ayahNumber":20,"textArabic":"ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍۢ","textEnglish":"[Who is] possessed of power and with the Owner of the Throne, secure [in position],","textTamil":"(அவர்) சக்திமிக்கவர்; அர்ஷுக்குடையவனிடம் பெரும் பதவியுடையவர்.","verseKey":"81:20","timestampFrom":52.53,"timestampTo":56.76},{"surahNumber":81,"ayahNumber":21,"textArabic":"مُّطَاعٍۢ ثَمَّ أَمِينٍۢ","textEnglish":"Obeyed there [in the heavens] and trustworthy.","textTamil":"(வானவர் தம்) தலைவர்; அன்றியும் நம்பிக்கைக்குரியவர்.","verseKey":"81:21","timestampFrom":56.76,"timestampTo":60.1},{"surahNumber":81,"ayahNumber":22,"textArabic":"وَمَا صَاحِبُكُم بِمَجْنُونٍۢ","textEnglish":"And your companion is not [at all] mad.","textTamil":"மேலும் உங்கள் தோழர் பைத்தியக்காரர் அல்லர்.","verseKey":"81:22","timestampFrom":60.1,"timestampTo":64.04},{"surahNumber":81,"ayahNumber":23,"textArabic":"وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ","textEnglish":"And he has already seen Gabriel in the clear horizon.","textTamil":"அவர் திட்டமாக அவரை (ஜிப்ரயீலை) தெளிவான அடிவானத்தில் கண்டார்.","verseKey":"81:23","timestampFrom":64.04,"timestampTo":67.78},{"surahNumber":81,"ayahNumber":24,"textArabic":"وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍۢ","textEnglish":"And Muhammad is not a withholder of [knowledge of] the unseen.","textTamil":"மேலும், அவர் மறைவான செய்திகளை கூறுவதில் உலோபித்தனம் செய்பவரல்லர்.","verseKey":"81:24","timestampFrom":67.78,"timestampTo":71.36},{"surahNumber":81,"ayahNumber":25,"textArabic":"وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍۢ رَّجِيمٍۢ","textEnglish":"And the Qur'an is not the word of a devil, expelled [from the heavens].","textTamil":"அன்றியும், இது விரட்டப்பட்ட ஷைத்தானின் வாக்கல்ல.","verseKey":"81:25","timestampFrom":71.36,"timestampTo":75.36},{"surahNumber":81,"ayahNumber":26,"textArabic":"فَأَيْنَ تَذْهَبُونَ","textEnglish":"So where are you going?","textTamil":"எனவே, (நேர்வழியை விட்டும்) நீங்கள் எங்கே செல்கின்றீர்கள்?","verseKey":"81:26","timestampFrom":75.36,"timestampTo":78.39},{"surahNumber":81,"ayahNumber":27,"textArabic":"إِنْ هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ","textEnglish":"It is not except a reminder to the worlds","textTamil":"இது, அகிலத்தாருக்கெல்லாம் உபதேசமாகும்.","verseKey":"81:27","timestampFrom":78.39,"timestampTo":82.33},{"surahNumber":81,"ayahNumber":28,"textArabic":"لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ","textEnglish":"For whoever wills among you to take a right course.","textTamil":"உங்களில் நின்றும் யார் நேர்வழியை விரும்புகிறாரோ, அவருக்கு (நல்லுபதேசமாகும்).","verseKey":"81:28","timestampFrom":82.33,"timestampTo":87.84},{"surahNumber":81,"ayahNumber":29,"textArabic":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ","textEnglish":"And you do not will except that Allah wills - Lord of the worlds.","textTamil":"ஆயினும், அகிலங்களுக்கெல்லாம் இறைவனாகிய அல்லாஹ் நாடினாலன்றி நீங்கள் (நல்லுபதேசம் பெற) நாடமாட்டீர்கள்.","verseKey":"81:29","timestampFrom":87.84,"timestampTo":98.76}]