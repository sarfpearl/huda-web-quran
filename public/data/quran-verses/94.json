[{"surahNumber":94,"ayahNumber":1,"textArabic":"أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","textEnglish":"Did We not expand for you, [O Muhammad], your breast?","textTamil":"நாம், உம் இதயத்தை உமக்காக விரிவாக்கவில்லையா?","verseKey":"94:1","timestampFrom":0,"timestampTo":2.4},{"surahNumber":94,"ayahNumber":2,"textArabic":"وَوَضَعْنَا عَنكَ وِزْرَكَ","textEnglish":"And We removed from you your burden","textTamil":"மேலும், நாம் உம்மை விட்டும் உம் சுமையை இறக்கினோம்.","verseKey":"94:2","timestampFrom":2.4,"timestampTo":5.04},{"surahNumber":94,"ayahNumber":3,"textArabic":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ","textEnglish":"Which had weighed upon your back","textTamil":"அது உம் முதுகை முறித்துக் கொண்டுடிருந்தது.","verseKey":"94:3","timestampFrom":5.04,"timestampTo":7.76},{"surahNumber":94,"ayahNumber":4,"textArabic":"وَرَفَعْنَا لَكَ ذِكْرَكَ","textEnglish":"And raised high for you your repute.","textTamil":"மேலும், நாம் உமக்காக உம்முடைய புகழை மேலோங்கச் செய்தோம்.","verseKey":"94:4","timestampFrom":7.76,"timestampTo":10.27},{"surahNumber":94,"ayahNumber":5,"textArabic":"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","textEnglish":"For indeed, with hardship [will be] ease.","textTamil":"ஆதலின் நிச்சயமாகத் துன்பத்துடன் இன்பம் இருக்கிறது.","verseKey":"94:5","timestampFrom":10.27,"timestampTo":13.09},{"surahNumber":94,"ayahNumber":6,"textArabic":"إِنَّ مَعَ ٱلْعُسْرِ يُسْرًۭا","textEnglish":"Indeed, with hardship [will be] ease.","textTamil":"நிச்சயமாக துன்பத்துடன் இன்பம் இருக்கிறது.","verseKey":"94:6","timestampFrom":13.09,"timestampTo":16.22},{"surahNumber":94,"ayahNumber":7,"textArabic":"فَإِذَا فَرَغْتَ فَٱنصَبْ","textEnglish":"So when you have finished [your duties], then stand up [for worship].","textTamil":"எனவே, (வேலைகளிலிருந்து) நீர் ஓய்ந்ததும் (இறைவழியிலும், வணக்கத்திலும்) முயல்வீராக.","verseKey":"94:7","timestampFrom":16.22,"timestampTo":19.51},{"surahNumber":94,"ayahNumber":8,"textArabic":"وَإِلَىٰ رَبِّكَ فَٱرْغَب","textEnglish":"And to your Lord direct [your] longing.","textTamil":"மேலும், முழு மனத்துடன் உம் இறைவன் பால் சார்ந்து விடுவீராக.","verseKey":"94:8","timestampFrom":19.51,"timestampTo":22.7}]