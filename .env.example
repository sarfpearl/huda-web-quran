# ── Supabase ────────────────────────────────────────────────────────────────
# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER expose this to the client / never prefix with NEXT_PUBLIC_.
# Used only in server-side admin operations & seed scripts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Site ──────────────────────────────────────────────────────────────────────
# Used for absolute URLs (SEO / Open Graph / sitemap / share links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Data source toggle ─────────────────────────────────────────────────────────
# "seed"     → use built-in demo data (default; no Supabase required)
# "supabase" → use the live Supabase database
NEXT_PUBLIC_DATA_SOURCE=seed

# Surah / Juz view count, live listeners and comments (home player) need the Supabase vars
# above and supabase/migrations/20260924130000_quran_views_comments.sql.

# ── Cloudflare R2 Media Storage ───────────────────────────────────────────────
# Public CDN / R2 dev URL for videos, images, and audio assets.
# Leave empty to serve media from local /public folder in development.
NEXT_PUBLIC_MEDIA_BASE_URL=https://pub-052ee8dfbe2748bbb3b9ad42d2f9e2b1.r2.dev

# ── Quran-reading reminders (Web Push) ────────────────────────────────────────
# docs/REMINDERS.md. Keys: `npx web-push generate-vapid-keys` (keep them forever).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional contact for push services (default https://www.hudaguidance.com).
VAPID_SUBJECT=
# Its SHA-256 is in Supabase public.reminder_secret (claim / drop RPCs).
REMINDER_SECRET=
# Supabase cron sends it to /api/reminders/send as a Bearer token.
REMINDER_CRON_TOKEN=
