# ── Supabase ────────────────────────────────────────────────────────────────
# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER expose this to the client / never prefix with NEXT_PUBLIC_.
# Used only in server-side admin operations & seed scripts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Site ──────────────────────────────────────────────────────────────────────
# Used for absolute URLs (SEO / Open Graph / sitemap / share links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Data source toggle ─────────────────────────────────────────────────────────
# "seed"     → use built-in demo data (default; no Supabase required)
# "supabase" → use the live Supabase database
NEXT_PUBLIC_DATA_SOURCE=seed

# Surah / Juz view count, live listeners and comments (home player) need the Supabase vars
# above and supabase/migrations/20260924130000_quran_views_comments.sql.
